<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Alquitel.Mobile.ViewModels"
             x:Class="Alquitel.Mobile.Views.CatalogPage"
             x:DataType="vm:CatalogViewModel"
             Title="Catálogo">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16,8,16,0" RowSpacing="10">

        <SearchBar Grid.Row="0" Text="{Binding SearchText}" Placeholder="Buscar producto…" />

        <Border Grid.Row="1" Style="{StaticResource InputBorder}">
            <Picker Title="Categoría"
                    ItemsSource="{Binding Categories}"
                    SelectedItem="{Binding SelectedCategory}" />
        </Border>

        <RefreshView Grid.Row="2" IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Products}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24" Spacing="8">
                        <Label Text="No hay productos que coincidan." Style="{StaticResource MutedLabel}" HorizontalOptions="Center" />
                        <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" HorizontalTextAlignment="Center"
                               IsVisible="{Binding ErrorMessage, Converter={StaticResource NotNullConverter}}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProductRow">
                        <Grid Padding="0,5">
                            <Border Style="{StaticResource Card}" Padding="14">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding OpenProductCommand, Source={RelativeSource AncestorType={x:Type vm:CatalogViewModel}}}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
                                    <Label Grid.ColumnSpan="2" FormattedText="{Binding FormattedDescription}" LineBreakMode="WordWrap" />
                                    <Label Grid.Row="1" Text="{Binding Category}" Style="{StaticResource MutedLabel}" FontSize="12" />
                                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding PriceText}" FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
