<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Alquitel.Mobile.ViewModels"
             xmlns:entities="clr-namespace:Alquitel.Core.Entities;assembly=Alquitel.Core"
             x:Class="Alquitel.Mobile.Views.OrdersPage"
             x:DataType="vm:OrdersViewModel"
             Title="Pool de pedidos">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16,8,16,0" RowSpacing="10">

        <SearchBar Grid.Row="0" Text="{Binding SearchText}" Placeholder="Buscar por número o cliente…" />

        <Border Grid.Row="1" Style="{StaticResource InputBorder}">
            <Picker Title="Filtrar por estado"
                    ItemsSource="{Binding StatusFilters}"
                    SelectedItem="{Binding SelectedStatusFilter}" />
        </Border>

        <RefreshView Grid.Row="2" IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Orders}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24" Spacing="8">
                        <Label Text="No hay pedidos que coincidan." Style="{StaticResource MutedLabel}" HorizontalOptions="Center" />
                        <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" HorizontalTextAlignment="Center"
                               IsVisible="{Binding ErrorMessage, Converter={StaticResource NotNullConverter}}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="entities:Order">
                        <Grid Padding="0,5">
                            <Border Style="{StaticResource Card}" Padding="14">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding OpenOrderCommand, Source={RelativeSource AncestorType={x:Type vm:OrdersViewModel}}}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                    <Label Grid.Row="0" Text="{Binding BudgetNumber, StringFormat='Nº {0}'}"
                                           FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource ChipBorder}"
                                            BackgroundColor="{Binding Status, Converter={StaticResource StatusColorConverter}}">
                                        <Label Text="{Binding Status, Converter={StaticResource StatusDisplayConverter}}"
                                               TextColor="White" FontSize="11" FontAttributes="Bold" />
                                    </Border>
                                    <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Client.CompanyName}"
                                           LineBreakMode="TailTruncation" />
                                    <Label Grid.Row="2" Text="{Binding CreatedDate, StringFormat='{0:dd/MM/yyyy}'}"
                                           Style="{StaticResource MutedLabel}" />
                                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding GrandTotal, StringFormat='$ {0:N0}'}"
                                           FontAttributes="Bold" />
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
