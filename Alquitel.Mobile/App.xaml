<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:Alquitel.Mobile.Converters"
             x:Class="Alquitel.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:NotNullConverter x:Key="NotNullConverter" />
            <conv:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <conv:StatusDisplayConverter x:Key="StatusDisplayConverter" />
            <conv:StatusColorConverter x:Key="StatusColorConverter" />
            <conv:ApprovalStatusConverter x:Key="ApprovalStatusConverter" />
            <conv:CuitFeedbackColorConverter x:Key="CuitFeedbackColorConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
