<Window x:Class="Alquitel.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Alquitel.UI.ViewModels"
        xmlns:views="clr-namespace:Alquitel.UI.Views"
        Title="Grupo Alquitel - Sistema Administrativo" Height="900" Width="1440"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- ViewModel → View mapping -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BudgetBuilderViewModel}">
            <views:BudgetBuilderView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductEditorViewModel}">
            <views:ProductEditorView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72"/>   <!-- Sidebar -->
            <ColumnDefinition Width="*"/>    <!-- Content -->
        </Grid.ColumnDefinitions>

        <!-- ═══════════════ SIDEBAR ═══════════════ -->
        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                BorderThickness="0,0,1,0" BorderBrush="{DynamicResource BorderBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Logo -->
                    <RowDefinition Height="*"/>     <!-- Nav Items -->
                    <RowDefinition Height="Auto"/>  <!-- Theme Toggle -->
                </Grid.RowDefinitions>

                <!-- Logo -->
                <Border Grid.Row="0" Margin="0,20,0,30" HorizontalAlignment="Center">
                    <Border Width="44" Height="44" CornerRadius="12"
                            Background="{DynamicResource SecondaryColorBrush}">
                        <TextBlock Text="A" FontSize="22" FontWeight="Black" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Border>

                <!-- Nav Buttons -->
                <StackPanel Grid.Row="1" VerticalAlignment="Top">
                    <!-- Dashboard -->
                    <Button Width="48" Height="48" Margin="0,4" Cursor="Hand"
                            ToolTip="Dashboard"
                            Command="{Binding NavigateToDashboardCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="navBg" Background="{TemplateBinding Background}"
                                                    CornerRadius="14" Padding="0">
                                                <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           x:Name="navIcon"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="navBg" Property="Background"
                                                            Value="{DynamicResource HoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSection}" Value="Dashboard">
                                        <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Budget Builder -->
                    <Button Width="48" Height="48" Margin="0,4" Cursor="Hand"
                            ToolTip="Crear Presupuesto"
                            Command="{Binding NavigateToBuilderCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="navBg" Background="{TemplateBinding Background}"
                                                    CornerRadius="14" Padding="0">
                                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="navBg" Property="Background"
                                                            Value="{DynamicResource HoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSection}" Value="Presupuesto">
                                        <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Products -->
                    <Button Width="48" Height="48" Margin="0,4" Cursor="Hand"
                            ToolTip="Gestión de Productos"
                            Command="{Binding NavigateToProductsCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="navBg" Background="{TemplateBinding Background}"
                                                    CornerRadius="14" Padding="0">
                                                <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="navBg" Property="Background"
                                                            Value="{DynamicResource HoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSection}" Value="Productos">
                                        <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Settings -->
                    <Button Width="48" Height="48" Margin="0,4" Cursor="Hand"
                            ToolTip="Configuración"
                            Command="{Binding NavigateToSettingsCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="navBg" Background="{TemplateBinding Background}"
                                                    CornerRadius="14" Padding="0">
                                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="navBg" Property="Background"
                                                            Value="{DynamicResource HoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSection}" Value="Configuración">
                                        <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Theme Toggle (bottom of sidebar) -->
                <Button Grid.Row="2" Width="48" Height="48" Margin="0,0,0,20" Cursor="Hand"
                        ToolTip="Cambiar tema claro/oscuro"
                        Command="{Binding ToggleThemeCommand}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="themeBg" Background="{TemplateBinding Background}"
                                                CornerRadius="14">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="20"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       x:Name="themeIcon">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="&#xE708;"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDarkMode}" Value="True">
                                                                <Setter Property="Text" Value="&#xE706;"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="themeBg" Property="Background"
                                                        Value="{DynamicResource HoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- ═══════════════ CONTENT AREA ═══════════════ -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}"/>
    </Grid>
</Window>
