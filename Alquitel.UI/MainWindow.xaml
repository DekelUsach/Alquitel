<Window x:Class="Alquitel.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Alquitel.UI.ViewModels"
        xmlns:views="clr-namespace:Alquitel.UI.Views"
        Title="Grupo Alquitel - Sistema Administrativo" Icon="/Assets/app.ico" Height="900" Width="1440"
        MinHeight="600" MinWidth="1000"
        ResizeMode="CanResize"
        FontFamily="{StaticResource AppFontFamily}"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="Manual">

    <!-- Atajos de teclado para navegación rápida -->
    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="D1" Command="{Binding NavigateToDashboardCommand}"/>
        <KeyBinding Modifiers="Control" Key="D2" Command="{Binding NavigateToBuilderCommand}"/>
        <KeyBinding Modifiers="Control" Key="D3" Command="{Binding NavigateToProductsCommand}"/>
        <KeyBinding Modifiers="Control" Key="D4" Command="{Binding NavigateToClientsCommand}"/>
        <KeyBinding Modifiers="Control" Key="D5" Command="{Binding NavigateToLocationsCommand}"/>
        <KeyBinding Modifiers="Control" Key="D6" Command="{Binding NavigateToPresupuestosCommand}"/>
        <KeyBinding Modifiers="Control" Key="D7" Command="{Binding NavigateToSettingsCommand}"/>
        <KeyBinding Modifiers="Control" Key="D8" Command="{Binding NavigateToReportsCommand}"/>
        <KeyBinding Modifiers="Control" Key="D9" Command="{Binding NavigateToOrderPoolCommand}"/>
        <KeyBinding Modifiers="Control" Key="T" Command="{Binding ToggleThemeCommand}"/>
        <KeyBinding Modifiers="Control" Key="K" Command="{Binding OpenCommandPaletteCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- ViewModel → View mapping -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BudgetBuilderViewModel}">
            <views:BudgetBuilderView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductEditorViewModel}">
            <views:ProductEditorView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PresupuestosViewModel}">
            <views:PresupuestosView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ClientsViewModel}">
            <views:ClientsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LocationsViewModel}">
            <views:LocationsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <views:ReportsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WorkOrdersViewModel}">
            <views:WorkOrdersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OrderPoolViewModel}">
            <views:OrderPoolView/>
        </DataTemplate>

        <!-- Ítem de navegación: ícono (Tag) + etiqueta (Content) + indicador (BorderBrush) -->
        <Style x:Key="NavItemButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="12,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Capa de hover con fade (el fondo activo sigue viniendo
                                     del setter Background del DataTrigger de sección) -->
                                <Border x:Name="hoverBg" Grid.ColumnSpan="3"
                                        Background="{DynamicResource HoverBrush}"
                                        CornerRadius="10" Opacity="0"/>
                                <Border Grid.Column="0" Width="3" Height="18" CornerRadius="2"
                                        Background="{TemplateBinding BorderBrush}" Margin="4,0,0,0"/>
                                <TextBlock Grid.Column="1" Text="{TemplateBinding Tag}"
                                           FontFamily="{StaticResource IconFont}" FontSize="16"
                                           Foreground="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{TemplateBinding Content}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hoverBg"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hoverBg"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Encabezado de grupo del menú -->
        <Style x:Key="NavGroupLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="Margin" Value="24,18,0,6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>  <!-- Sidebar -->
            <ColumnDefinition Width="*"/>    <!-- Content -->
        </Grid.ColumnDefinitions>

        <!-- ═══════════════ SIDEBAR ═══════════════ -->
        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                BorderThickness="0,0,1,0" BorderBrush="{DynamicResource BorderBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Logo -->
                    <RowDefinition Height="*"/>     <!-- Nav Items -->
                    <RowDefinition Height="Auto"/>  <!-- Theme Toggle -->
                </Grid.RowDefinitions>

                <!-- Marca -->
                <Border Grid.Row="0" Margin="16,18,16,12"
                        Background="{DynamicResource LogoBackingBrush}"
                        CornerRadius="8" Padding="6,6,8,6">
                    <StackPanel>
                        <Image Source="/Assets/logo.png" Height="42" Stretch="Uniform"
                               HorizontalAlignment="Left" SnapsToDevicePixels="True"/>
                        <TextBlock Text="GESTIÓN CORPORATIVA" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedTextBrush}" Opacity="0.85"
                                   Margin="2,7,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Menú -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="GENERAL" Style="{StaticResource NavGroupLabel}"/>

                        <Button Tag="&#xE80F;" Content="Dashboard" ToolTip="Panel de control (Ctrl+1)"
                                Command="{Binding NavigateToDashboardCommand}"
                                Visibility="{Binding IsCommercial, Converter={StaticResource BoolToVis}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItemButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveSection}" Value="Dashboard">
                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryColorBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Tag="&#xE8A5;" Content="Crear Presupuesto" ToolTip="Armar presupuesto / OT (Ctrl+2)"
                                Command="{Binding NavigateToBuilderCommand}"
                                Visibility="{Binding IsCommercial, Converter={StaticResource BoolToVis}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItemButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveSection}" Value="Presupuesto">
                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryColorBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Tag="&#xE9F9;" Content="Presupuestos" ToolTip="Listado de documentos generados (Ctrl+6)"
                                Command="{Binding NavigateToPresupuestosCommand}"
                                Visibility="{Binding IsCommercial, Converter={StaticResource BoolToVis}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItemButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveSection}" Value="Presupuestos">
                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryColorBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Tag="&#xE9D5;" Content="Seguimiento" ToolTip="Pool de presupuestos, OT y facturación con sus estados (Ctrl+9)"
                                Command="{Binding NavigateToOrderPoolCommand}"
                                Visibility="{Binding IsCommercial, Converter={StaticResource BoolToVis}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItemButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveSection}" Value="Seguimiento">
                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryColorBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Tag="&#xE9D2;" Content="Reportes" ToolTip="Facturación y rentabilidad (Ctrl+8)"
                                Command="{Binding NavigateToReportsCommand}"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItemButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveSection}" Value="Reportes">
                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryColorBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Tag="&#xE90F;" Content="Órdenes de Trabajo" ToolTip="Ver y previsualizar las OT generadas"
                                Command="{Binding NavigateToWorkOrdersCommand}"
                                Visibility="{Binding CanSeeWorkOrders, Converter={StaticResource BoolToVis}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItemButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveSection}" Value="OrdenesTrabajo">
                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryColorBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <TextBlock Text="CATÁLOGO" Style="{StaticResource NavGroupLabel}"/>

                        <Button Tag="&#xE7B8;" Content="Productos" ToolTip="Gestión de productos (Ctrl+3)"
                                Command="{Binding NavigateToProductsCommand}"
                                Visibility="{Binding CanSeeProducts, Converter={StaticResource BoolToVis}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItemButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveSection}" Value="Productos">
                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryColorBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Tag="&#xE716;" Content="Clientes" ToolTip="Directorio de clientes (Ctrl+4)"
                                Command="{Binding NavigateToClientsCommand}"
                                Visibility="{Binding IsCommercial, Converter={StaticResource BoolToVis}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItemButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveSection}" Value="Clientes">
                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryColorBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Tag="&#xE707;" Content="Ubicaciones" ToolTip="Gestión de ubicaciones (Ctrl+5)"
                                Command="{Binding NavigateToLocationsCommand}"
                                Visibility="{Binding IsCommercial, Converter={StaticResource BoolToVis}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItemButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveSection}" Value="Ubicaciones">
                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryColorBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <TextBlock Text="SISTEMA" Style="{StaticResource NavGroupLabel}"
                                   Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>

                        <Button Tag="&#xE713;" Content="Configuración" ToolTip="Rutas y plantillas (Ctrl+7)"
                                Command="{Binding NavigateToSettingsCommand}"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItemButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveSection}" Value="Configuración">
                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryColorBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Tema + versión -->
                <StackPanel Grid.Row="2" Margin="0,0,0,14">
                    <Separator Background="{DynamicResource BorderBrush}" Margin="16,0,16,10" Height="1"/>
                    <Button ToolTip="Cambiar tema claro/oscuro (Ctrl+T)"
                            Command="{Binding ToggleThemeCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItemButton}">
                                <Setter Property="Tag" Value="&#xE708;"/>
                                <Setter Property="Content" Value="Modo oscuro"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkMode}" Value="True">
                                        <Setter Property="Tag" Value="&#xE706;"/>
                                        <Setter Property="Content" Value="Modo claro"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Tag="&#xE7E8;" Content="Cerrar sesión" ToolTip="Cerrar sesión"
                            Command="{Binding LogoutCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItemButton}"/>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════ CONTENT AREA ═══════════════ -->
        <!-- NotifyOnTargetUpdated + code-behind: fade/slide de 200 ms al navegar
             (respeta SystemParameters.ClientAreaAnimation para accesibilidad). -->
        <ContentControl x:Name="MainContent" Grid.Row="0" Grid.Column="1"
                        Content="{Binding CurrentViewModel, NotifyOnTargetUpdated=True}"
                        TargetUpdated="MainContent_TargetUpdated"
                        RenderTransformOrigin="0.5,0.5">
            <ContentControl.RenderTransform>
                <TranslateTransform/>
            </ContentControl.RenderTransform>
        </ContentControl>

        <!-- ═══════════════ TOASTS (overlay, no bloqueante) ═══════════════ -->
        <ItemsControl Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Toasts.Items}"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="0,0,24,24" IsHitTestVisible="True" Panel.ZIndex="1000">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="14,12" Margin="0,8,0,0"
                            MinWidth="280" MaxWidth="420" HorizontalAlignment="Right">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.25"/>
                        </Border.Effect>
                        <Border.Triggers>
                            <!-- Entrada 200 ms (fade + slide): respeta reduced-motion vía
                                 ClientAreaAnimation en el code-behind del Loaded si hiciera falta;
                                 opacity/transform no causan layout shift. -->
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         From="12" To="0" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <Border.RenderTransform>
                            <TranslateTransform/>
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding IconGlyph}"
                                       FontFamily="{StaticResource IconFont}" FontSize="15"
                                       VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryColorBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap"
                                       FontSize="12.5" Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Content="{Binding ActionLabel}"
                                    Command="{Binding RunActionCommand}"
                                    Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Foreground="{DynamicResource SecondaryColorBrush}"
                                    FontWeight="SemiBold" FontSize="12" Padding="10,4"
                                    Margin="8,0,0,0" MinHeight="36"
                                    AutomationProperties.Name="{Binding ActionLabel}"/>
                            <Button Grid.Column="3" Content="&#xE711;" FontFamily="{StaticResource IconFont}"
                                    Command="{Binding DismissCommand}" ToolTip="Cerrar aviso"
                                    AutomationProperties.Name="Cerrar aviso"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Foreground="{DynamicResource MutedTextBrush}" FontSize="12"
                                    Padding="8,4" Margin="4,0,0,0" MinWidth="36" MinHeight="36"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ═══════════════ STATUS BAR ═══════════════ -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource SurfaceBrush}"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}" Height="28">
            <Grid Margin="16,0">
                <TextBlock Text="Grupo Alquitel · Sistema de Gestión Interna"
                           FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="11"
                               Foreground="{DynamicResource SecondaryColorBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                               VerticalAlignment="Center" Margin="0,0,16,0">
                        <Run Text="{Binding CurrentUserName, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" · "/><Run Text="{Binding CurrentUserRoleLabel, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="&#xEDA2;" FontFamily="{StaticResource IconFont}" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,6,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                <Style.Triggers>
                                    <!-- Rojo cuando el servidor compartido no responde -->
                                    <DataTrigger Binding="{Binding IsConnectionHealthy}" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding DatabaseModeLabel, Mode=OneWay}" FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding AppVersion}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
