<Window x:Class="Alquitel.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Alquitel.UI.ViewModels"
        xmlns:conv="clr-namespace:Alquitel.UI.Converters"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:helpers="clr-namespace:Alquitel.UI.Helpers"
        Title="Grupo Alquitel - Sistema Administrativo" Height="900" Width="1440"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:ProductButtonTextConverter x:Key="ProductButtonTextConverter"/>
        <conv:ProductButtonBackgroundConverter x:Key="ProductButtonBackgroundConverter"/>
        <conv:ProductRemoveButtonVisibilityConverter x:Key="ProductRemoveButtonVisibilityConverter"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <helpers:BindingProxy x:Key="Proxy" Data="{Binding}"/>
    </Window.Resources>
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/> <!-- Sidebar/Products -->
            <ColumnDefinition Width="*"/>   <!-- Editor -->
        </Grid.ColumnDefinitions>
        
        <!-- BARRA LATERAL: CATÁLOGO DE PRODUCTOS -->
        <Border Grid.Column="0" Background="Transparent" Padding="15">
            <StackPanel>
                <!-- Título / Logo Placeholder as per Mockup -->
                <Grid Margin="0,10,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Grupo Alquitel"
                               FontSize="32" FontWeight="Black" FontStyle="Italic"
                               Foreground="{StaticResource SecondaryColorBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <Button Grid.Column="1" Style="{StaticResource DarkPillButton}"
                            Height="38" Width="38" Padding="0"
                            VerticalAlignment="Center"
                            ToolTip="Cambiar tema claro/oscuro"
                            Command="{Binding ToggleThemeCommand}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE708;"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkMode}" Value="True">
                                            <Setter Property="Text" Value="&#xE706;"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="48"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             VerticalAlignment="Center" Height="45" Effect="{StaticResource StandardShadow}"/>

                    <Button Grid.Column="1" Style="{StaticResource DarkPillButton}" Margin="8,0,0,0" Height="45"
                            ToolTip="Armar pedido desde texto"
                            Command="{Binding ParseSmartSearchCommand}">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>

                    <Button Grid.Column="2" Style="{StaticResource DarkPillButton}" Margin="8,0,0,0" Height="45"
                            ToolTip="Mostrar/Ocultar input de texto"
                            Command="{Binding ToggleSmartSearchInputCommand}">
                        <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                </Grid>

                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="12" Margin="0,0,0,20"
                        Visibility="{Binding IsSmartSearchVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                        Effect="{StaticResource StandardShadow}">
                    <StackPanel>
                        <TextBlock Text="Pegá un párrafo con productos y cantidades. Luego tocá la lupa para armar el pedido automático."
                                   TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,8"/>
                        <TextBox Height="90" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding SmartSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Border>
                
                <!-- Lista de Productos -->
                <ListBox ItemsSource="{Binding AvailableProducts}" Background="Transparent" BorderThickness="0" Height="650" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="15" Margin="5,5,5,15" BorderThickness="0" Width="310" Effect="{StaticResource StandardShadow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Image Placeholder -->
                                    <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="3" Width="70" Height="70" Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Margin="0,0,10,0"/>

                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Description}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Category}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BasePrice, StringFormat='{}{0:C}'}" FontSize="15" Foreground="{StaticResource TextBrush}" FontWeight="Bold"/>
                                    
                                    <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,15,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"
                                                Style="{StaticResource DarkPillButton}"
                                                Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Height="40"
                                                Margin="0">
                                            <Button.Content>
                                                <MultiBinding Converter="{StaticResource ProductButtonTextConverter}">
                                                    <Binding/>
                                                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    <Binding Path="DataContext.SelectionVersion" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                </MultiBinding>
                                            </Button.Content>
                                            <Button.Background>
                                                <MultiBinding Converter="{StaticResource ProductButtonBackgroundConverter}">
                                                    <Binding/>
                                                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    <Binding Path="DataContext.SelectionVersion" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                </MultiBinding>
                                            </Button.Background>
                                        </Button>

                                        <Button Grid.Column="1"
                                                Content="-"
                                                Width="40"
                                                Height="40"
                                                Margin="8,0,0,0"
                                                Foreground="White"
                                                Background="#D46A6A"
                                                BorderThickness="0"
                                                FontSize="18"
                                                FontWeight="Bold"
                                                Cursor="Hand"
                                                Command="{Binding DataContext.RemoveProductCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Button.Visibility>
                                                <MultiBinding Converter="{StaticResource ProductRemoveButtonVisibilityConverter}">
                                                    <Binding/>
                                                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    <Binding Path="IsMouseOver" RelativeSource="{RelativeSource AncestorType=Border}"/>
                                                    <Binding Path="DataContext.SelectionVersion" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                </MultiBinding>
                                            </Button.Visibility>
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="20">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>
        
        <!-- ÁREA DE TRABAJO DEL DOCUMENTO -->
        <Border Grid.Column="1" Padding="20,10,40,20" Background="Transparent">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Row 0: Encabezado -->
                    <RowDefinition Height="Auto"/>  <!-- Row 1: Panel configuración (colapsable) -->
                    <RowDefinition Height="*"/>     <!-- Row 2: Tabla -->
                    <RowDefinition Height="Auto"/>  <!-- Row 3: Botonera -->
                </Grid.RowDefinitions>

                <!-- ENCABEZADO: INFORMACIÓN DEL CLIENTE Y GENERAL -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>

                    <!-- Fila 1 -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,20,20">
                        <TextBlock Text="Empresa / Cliente" Foreground="{StaticResource TextBrush}" FontWeight="Bold" Margin="5,0,0,8" FontSize="13"/>
                        <TextBox Height="45" Text="{Binding CurrentOrder.Client.CompanyName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,20,20">
                        <TextBlock Text="Nº Presupuesto" Foreground="{StaticResource TextBrush}" FontWeight="Bold" Margin="5,0,0,8" FontSize="13"/>
                        <TextBox Height="45" Text="{Binding CurrentOrder.BudgetNumber, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Botón Configuración -->
                    <Button Grid.Row="0" Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,20"
                            Style="{StaticResource DarkPillButton}" Height="45" Width="45" Padding="0"
                            ToolTip="Configuración de rutas"
                            Command="{Binding ToggleSettingsCommand}">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="17" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>

                    <!-- Fila 2 -->
                    <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="0.8*"/>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="1.4*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock Text="Fecha del Evento" Foreground="{StaticResource TextBrush}" FontWeight="Bold" Margin="5,0,0,8" FontSize="13"/>
                            <Border Background="{StaticResource SurfaceBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" CornerRadius="18" Effect="{StaticResource StandardShadow}" Height="45">
                                <DatePicker SelectedDate="{Binding CurrentOrder.EventDate, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Margin="10,0"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,20,0">
                            <TextBlock Text="Días" Foreground="{StaticResource TextBrush}" FontWeight="Bold" Margin="5,0,0,8" FontSize="13"/>
                            <TextBox Height="45" Text="{Binding EventDays, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,20,0">
                            <TextBlock Text="Lugar del Evento" Foreground="{StaticResource TextBrush}" FontWeight="Bold" Margin="5,0,0,8" FontSize="13"/>
                            <TextBox Height="45" Text="{Binding CurrentOrder.Location.Name, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Margin="0,0,0,0">
                            <TextBlock Text="Administrador (Autor)" Foreground="{StaticResource TextBrush}" FontWeight="Bold" Margin="5,0,0,8" FontSize="13"/>
                            <TextBox Height="45" Text="{Binding CurrentOrder.AdminName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- PANEL CONFIGURACIÓN DE RUTAS (Row 1 — colapsable) -->
                <Border Grid.Row="1"
                        Background="{StaticResource SurfaceBrush}" CornerRadius="20" Padding="24,20"
                        Margin="0,0,0,20" Effect="{StaticResource StandardShadow}"
                        Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header row -->
                        <Grid Grid.Row="0" Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{StaticResource SecondaryColorBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="CONFIGURACIÓN DE RUTAS" FontWeight="Bold" FontSize="14"
                                           Foreground="{StaticResource SecondaryColorBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource DarkPillButton}" Height="32" Width="32" Padding="0"
                                    ToolTip="Cerrar" Command="{Binding ToggleSettingsCommand}">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Button>
                        </Grid>

                        <!-- 3-column card layout: Presupuestos | OF | OT -->
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- PRESUPUESTOS -->
                            <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource BackgroundBrush}" CornerRadius="14" Padding="16,14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Border Width="6" Height="6" CornerRadius="3" Background="{StaticResource SecondaryColorBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Presupuestos" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="Carpeta destino" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="38"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Height="38" FontSize="11" Text="{Binding PresupuestosFolder, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Grid.Column="1" Style="{StaticResource DarkPillButton}" Height="38" Width="38" Padding="0" Margin="4,0,0,0"
                                                ToolTip="Seleccionar carpeta" Command="{Binding BrowsePresupuestosFolderCommand}">
                                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="Plantilla (.docx)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="38"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Height="38" FontSize="11" Text="{Binding PresupuestosTemplate, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Grid.Column="1" Style="{StaticResource DarkPillButton}" Height="38" Width="38" Padding="0" Margin="4,0,0,0"
                                                ToolTip="Seleccionar plantilla" Command="{Binding BrowsePresupuestosTemplateCommand}">
                                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- OF -->
                            <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource BackgroundBrush}" CornerRadius="14" Padding="16,14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Border Width="6" Height="6" CornerRadius="3" Background="{StaticResource SecondaryColorBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Orden de Facturación" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="Carpeta destino" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="38"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Height="38" FontSize="11" Text="{Binding OfFolder, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Grid.Column="1" Style="{StaticResource DarkPillButton}" Height="38" Width="38" Padding="0" Margin="4,0,0,0"
                                                ToolTip="Seleccionar carpeta" Command="{Binding BrowseOfFolderCommand}">
                                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="Plantilla (.docx)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="38"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Height="38" FontSize="11" Text="{Binding OfTemplate, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Grid.Column="1" Style="{StaticResource DarkPillButton}" Height="38" Width="38" Padding="0" Margin="4,0,0,0"
                                                ToolTip="Seleccionar plantilla" Command="{Binding BrowseOfTemplateCommand}">
                                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- OT -->
                            <Border Grid.Row="0" Grid.Column="4" Background="{StaticResource BackgroundBrush}" CornerRadius="14" Padding="16,14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Border Width="6" Height="6" CornerRadius="3" Background="{StaticResource SecondaryColorBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Orden de Trabajo" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="Carpeta destino" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="38"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Height="38" FontSize="11" Text="{Binding OtFolder, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Grid.Column="1" Style="{StaticResource DarkPillButton}" Height="38" Width="38" Padding="0" Margin="4,0,0,0"
                                                ToolTip="Seleccionar carpeta" Command="{Binding BrowseOtFolderCommand}">
                                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="Plantilla (.docx)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="38"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Height="38" FontSize="11" Text="{Binding OtTemplate, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Grid.Column="1" Style="{StaticResource DarkPillButton}" Height="38" Width="38" Padding="0" Margin="4,0,0,0"
                                                ToolTip="Seleccionar plantilla" Command="{Binding BrowseOtTemplateCommand}">
                                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5"
                                    Content="GUARDAR CONFIGURACIÓN"
                                    Height="40" Width="200"
                                    HorizontalAlignment="Center"
                                    Margin="0,16,0,0"
                                    Style="{StaticResource DarkPillButton}"
                                    Command="{Binding SaveSettingsCommand}"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- PESTAÑAS Y TABLA DE DATOS -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                        <Button Height="44" Padding="24,0" Margin="0,0,10,0"
                                Cursor="Hand" BorderThickness="0"
                                Command="{Binding SetCommercialViewCommand}"
                                Effect="{StaticResource StandardShadow}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="14"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="20" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTechnicalView}" Value="False">
                                            <Setter Property="Background" Value="{StaticResource SecondaryColorBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="PRESUPUESTO COMERCIAL" FontWeight="Bold" FontSize="14"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>

                        <Button Height="44" Padding="24,0"
                                Cursor="Hand" BorderThickness="0"
                                Command="{Binding SetTechnicalViewCommand}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="14"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="20" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTechnicalView}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SecondaryColorBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="ORDEN DE TRABAJO (TÉCNICA)" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                    </StackPanel>

                    <!-- LA TABLA GRANDE -->
                    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="20" Padding="30,20" Effect="{StaticResource StandardShadow}">
                        <DataGrid ItemsSource="{Binding SelectedItems}" AutoGenerateColumns="False" 
                                  CanUserAddRows="False" CanUserDeleteRows="False" RowDetailsVisibilityMode="Collapsed"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  RowHeight="60">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="EQUIPAMIENTO" Binding="{Binding Product.Description}" Width="3*" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                            <Setter Property="TextAlignment" Value="Left"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                            <Setter Property="Margin" Value="4,0,0,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="CANTIDAD" Binding="{Binding Quantity}" Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="DÍAS" Binding="{Binding Dias}" Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="PRECIO UNIT." Binding="{Binding UnitPrice, StringFormat='{}{0:C}'}" Width="140"
                                                    Visibility="{Binding Data.CommercialColumnsVisibility, Source={StaticResource Proxy}}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="TextAlignment" Value="Right"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="0,0,6,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                            <Setter Property="TextAlignment" Value="Right"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="SUBTOTAL" Binding="{Binding Total, Mode=OneWay, StringFormat='{}{0:C}'}" Width="150" IsReadOnly="True"
                                                    Visibility="{Binding Data.CommercialColumnsVisibility, Source={StaticResource Proxy}}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="TextAlignment" Value="Right"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Margin" Value="0,0,6,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Header="ACCIONES" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Borrar"
                                                    Style="{StaticResource DarkPillButton}"
                                                    Height="34"
                                                    Width="90"
                                                    Padding="8,4"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <!-- BOTONERA INFERIOR -->
                <StackPanel Grid.Row="3" Margin="0,30,0,0">
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="18,12" Effect="{StaticResource StandardShadow}" HorizontalAlignment="Stretch"
                            Visibility="{Binding CommercialColumnsVisibility}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="PRESUPUESTO FINAL:" FontWeight="Bold" Foreground="{StaticResource TextBrush}" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding FinalBudget, Mode=OneWay, StringFormat={}{0:C2}, FallbackValue=$0.00, TargetNullValue=$0.00}" FontWeight="Black" Foreground="{StaticResource SecondaryColorBrush}" FontSize="22" Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Height="50" Width="220" Style="{StaticResource DarkPillButton}"
                                Command="{Binding GenerateBudgetCommand}"
                                Visibility="{Binding CommercialColumnsVisibility}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="GENERAR PRESUPUESTO" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Height="50" Width="230" Style="{StaticResource DarkPillButton}" Margin="15,0"
                                Command="{Binding GenerateOFCommand}"
                                Visibility="{Binding CommercialColumnsVisibility}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="GENERAR O. FACTURACIÓN" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Height="50" Width="220" Style="{StaticResource DarkPillButton}"
                                Command="{Binding GenerateOTCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9F5;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="GENERAR O. TRABAJO" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
