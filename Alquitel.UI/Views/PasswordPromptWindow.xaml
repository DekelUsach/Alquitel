<Window x:Class="Alquitel.UI.Views.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Establecer contraseña"
        Width="400" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFontFamily}"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Border Padding="28,24">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
            <TextBlock Text="La contraseña se pedirá al iniciar sesión con este usuario."
                       FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,18"/>

            <TextBlock Text="Nueva contraseña" Style="{StaticResource FieldLabel}"/>
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Margin="0,0,0,10">
                <PasswordBox x:Name="PasswordInput" Padding="14,10" FontSize="14"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource TextBrush}"
                             CaretBrush="{DynamicResource TextBrush}"/>
            </Border>

            <TextBlock Text="Confirmar contraseña" Style="{StaticResource FieldLabel}"/>
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Margin="0,0,0,10">
                <PasswordBox x:Name="ConfirmInput" Padding="14,10" FontSize="14"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource TextBrush}"
                             CaretBrush="{DynamicResource TextBrush}"/>
            </Border>

            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}"
                       FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                       Margin="4,0,0,10"/>

            <Button Content="Guardar contraseña" Style="{StaticResource PrimaryButton}"
                    Height="42" Margin="0,4,0,8" Click="Save_Click" IsDefault="True"/>
            <Button x:Name="RemoveButton" Content="Quitar contraseña (entrar sin contraseña)"
                    Style="{StaticResource GhostDangerButton}" Height="40"
                    Margin="0,0,0,8" Click="Remove_Click" Visibility="Collapsed"/>
            <Button Content="Cancelar" Style="{StaticResource GhostButton}"
                    Height="38" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Border>
</Window>
