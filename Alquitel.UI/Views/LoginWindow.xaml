<Window x:Class="Alquitel.UI.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alquitel - Iniciar sesión"
        Icon="/Assets/app.ico"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFontFamily}"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Border Padding="32,28">
        <StackPanel>
            <!-- Marca -->
            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,22">
                <Image Source="/Assets/logo.png" Height="58" Stretch="Uniform"
                       HorizontalAlignment="Center" SnapsToDevicePixels="True"/>
                <TextBlock Text="GESTIÓN CORPORATIVA" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource MutedTextBrush}" Opacity="0.8"
                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>

            <TextBlock Text="Usuario" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="UsersCombo" DisplayMemberPath="Name" Margin="0,0,0,14"
                      SelectionChanged="UsersCombo_SelectionChanged"/>

            <StackPanel x:Name="PasswordPanel" Visibility="Collapsed">
                <TextBlock Text="Contraseña" Style="{StaticResource FieldLabel}"/>
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Margin="0,0,0,14">
                    <PasswordBox x:Name="PasswordInput" Padding="14,10" FontSize="14"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextBrush}"
                                 CaretBrush="{DynamicResource TextBrush}"
                                 KeyDown="PasswordInput_KeyDown"/>
                </Border>
            </StackPanel>

            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}"
                       FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                       Margin="4,0,0,10"/>

            <Button x:Name="LoginButton" Content="Entrar" Style="{StaticResource PrimaryButton}"
                    Height="42" Click="Login_Click" IsDefault="True"/>

            <TextBlock x:Name="ModeText" FontSize="11" Margin="0,16,0,0"
                       Foreground="{DynamicResource MutedTextBrush}"
                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
