<UserControl x:Class="Alquitel.UI.Views.PresupuestosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid ClipToBounds="True">

        <!-- ══════════════════ MAIN CONTENT ══════════════════ -->
        <Grid Margin="32,26,32,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Presupuestos"
                           Style="{StaticResource PageTitle}"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                        Height="42" Padding="16,0" Margin="0,0,8,0"
                        Command="{Binding RefreshCommand}"
                        ToolTip="Recargar lista">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Recargar" FontWeight="SemiBold" FontSize="13"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}"
                        Height="42" Padding="16,0" Margin="0"
                        Command="{Binding ClearFiltersCommand}"
                        ToolTip="Limpiar filtros">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Limpiar filtros" FontWeight="SemiBold" FontSize="13"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Folder Path Bar -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20,14"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="4,0,14,0">
                        <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                   Foreground="{DynamicResource SecondaryColorBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Carpeta:" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBox Grid.Column="1" Height="40"
                             Text="{Binding FolderPath, UpdateSourceTrigger=LostFocus}"
                             VerticalContentAlignment="Center"
                             FontFamily="Consolas" FontSize="13"/>

                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}"
                            Height="40" Padding="16,0" Margin="8,0,0,0"
                            Command="{Binding BrowseFolderCommand}"
                            ToolTip="Elegir carpeta">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xED25;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Elegir..." FontWeight="SemiBold" FontSize="13"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Filter Bar -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="20,14"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search -->
                    <Grid Grid.Column="0">
                        <TextBox Height="40"
                                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="40,10,15,10"/>
                        <TextBlock Text="&#xE71E;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   VerticalAlignment="Center" Margin="14,0,0,0"
                                   IsHitTestVisible="False"/>
                        <TextBlock Text="Buscar por N°, empresa, ubicación, creador o nombre de archivo..."
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="13"
                                   VerticalAlignment="Center" Margin="42,0,0,0"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FilterText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Date From -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="DESDE (MODIFICADO)" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedTextBrush}" Margin="4,0,0,4"/>
                        <DatePicker SelectedDate="{Binding FilterDateFrom}" Height="42"/>
                    </StackPanel>

                    <!-- Date To -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="HASTA (MODIFICADO)" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedTextBrush}" Margin="4,0,0,4"/>
                        <DatePicker SelectedDate="{Binding FilterDateTo}" Height="42"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Status Bar -->
            <TextBlock Grid.Row="3" Text="{Binding StatusMessage}"
                       FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                       Margin="4,0,0,10"/>

            <!-- Skeleton mientras se escanea la carpeta (red/carpetas grandes) -->
            <Border Grid.Row="4" Style="{StaticResource Card}" Padding="16"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                    Panel.ZIndex="1">
                <StackPanel VerticalAlignment="Top">
                    <Border Style="{StaticResource SkeletonRow}"/>
                    <Border Style="{StaticResource SkeletonRow}" Opacity="0.5"/>
                    <Border Style="{StaticResource SkeletonRow}" Opacity="0.45"/>
                    <Border Style="{StaticResource SkeletonRow}" Opacity="0.4"/>
                    <Border Style="{StaticResource SkeletonRow}" Opacity="0.3"/>
                </StackPanel>
            </Border>

            <!-- DataGrid -->
            <Border Grid.Row="4" Style="{StaticResource Card}">
                <DataGrid x:Name="FilesGrid"
                          ItemsSource="{Binding FilesView}"
                          SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserReorderColumns="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="True"
                          SelectionUnit="FullRow"
                          MouseDoubleClick="FilesGrid_MouseDoubleClick"
                          Margin="0">
                    <DataGrid.Columns>

                        <DataGridTextColumn Header="N° PRESUPUESTO"
                                            Binding="{Binding BudgetNumber}"
                                            Width="*"
                                            ElementStyle="{StaticResource DataGridCellText}"/>

                        <DataGridTextColumn Header="EMPRESA / CLIENTE"
                                            Binding="{Binding Company}"
                                            Width="1.8*"
                                            ElementStyle="{StaticResource DataGridCellText}"/>

                        <DataGridTextColumn Header="UBICACIÓN"
                                            Binding="{Binding LocationName}"
                                            Width="1.3*"
                                            ElementStyle="{StaticResource DataGridCellTextMuted}"/>

                        <DataGridTextColumn Header="CREADOR"
                                            Binding="{Binding Initials}"
                                            Width="0.7*"
                                            ElementStyle="{StaticResource DataGridCellTextAccent}"/>

                        <DataGridTextColumn Header="ARCHIVO"
                                            Binding="{Binding FileName}"
                                            Width="2*"
                                            ElementStyle="{StaticResource DataGridCellTextMuted}"/>

                        <DataGridTextColumn Header="MODIFICADO"
                                            Binding="{Binding ModifiedDate, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                            Width="*"
                                            ElementStyle="{StaticResource DataGridCellTextMuted}"/>

                        <DataGridTextColumn Header="TAMAÑO"
                                            Binding="{Binding SizeFormatted}"
                                            Width="0.7*"
                                            ElementStyle="{StaticResource DataGridCellTextAccent}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- ══════════════════ DIM OVERLAY ══════════════════ -->
        <Border Background="#60000000"
                Panel.ZIndex="1"
                Visibility="{Binding IsDetailPanelOpen, Converter={StaticResource BoolToVis}}"
                MouseLeftButtonDown="DimOverlay_MouseLeftButtonDown"/>

        <!-- ══════════════════ FLYOUT DETAIL PANEL ══════════════════ -->
        <Border x:Name="DetailPanel"
                Width="420"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Background="{DynamicResource SurfaceBrush}"
                BorderThickness="1,0,0,0"
                BorderBrush="{DynamicResource BorderBrush}"
                Panel.ZIndex="2">
            <Border.RenderTransform>
                <TranslateTransform X="420"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Direction="180" ShadowDepth="0" BlurRadius="24" Opacity="0.3" Color="#000000"/>
            </Border.Effect>

            <Grid Margin="28,28,28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Panel header -->
                <Grid Grid.Row="0" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Detalle del archivo"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Width="36" Height="36"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding CloseDetailCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="{TemplateBinding Background}"
                                        CornerRadius="18">
                                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}"
                                               FontSize="14" Foreground="{DynamicResource MutedTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background"
                                                Value="{DynamicResource HoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Panel content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Budget number -->
                        <TextBlock Text="{Binding SelectedFile.BudgetNumber, StringFormat='N° {0}'}"
                                   FontSize="28" FontWeight="Black"
                                   Foreground="{DynamicResource SecondaryColorBrush}"
                                   Margin="0,0,0,20"/>

                        <!-- Field group: parsed info -->
                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                CornerRadius="14" Padding="18,16"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="EMPRESA / CLIENTE" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding SelectedFile.Company}"
                                               FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="UBICACIÓN" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding SelectedFile.LocationName}"
                                               FontSize="14" Foreground="{DynamicResource TextBrush}"/>
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="INICIALES" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding SelectedFile.Initials}"
                                               FontSize="14" Foreground="{DynamicResource TextBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- File info -->
                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                CornerRadius="14" Padding="18,16"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="ARCHIVO" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding SelectedFile.FileName}"
                                               FontFamily="Consolas" FontSize="12"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="RUTA COMPLETA" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding SelectedFile.FullPath}"
                                               FontFamily="Consolas" FontSize="11"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="MODIFICADO" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding SelectedFile.ModifiedDate, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                                   FontSize="13" Foreground="{DynamicResource TextBrush}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="TAMAÑO" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding SelectedFile.SizeFormatted}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SecondaryColorBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- Action buttons -->
                <StackPanel Grid.Row="2" Margin="0,20,0,0">
                    <Button Style="{StaticResource PrimaryButton}"
                            Height="46" Margin="0,0,0,8" Padding="0"
                            Command="{Binding OpenFileCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Abrir archivo" FontWeight="Bold" FontSize="14"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}"
                            Height="42" Margin="0,0,0,8" Padding="0"
                            Command="{Binding CreateVersionCommand}"
                            ToolTip="Crea una rama de este presupuesto (31294 → 31294/2) con un editor rápido de ítems. La versión original no se modifica.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8F4;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="Crear nueva versión" FontWeight="SemiBold" FontSize="13"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}"
                            Height="42" Margin="0,0,0,8" Padding="0"
                            Command="{Binding RepeatOrderCommand}"
                            ToolTip="Abre el armador con una copia de este presupuesto: mismos productos y cliente, número y fechas nuevos, precios actualizados al catálogo de hoy.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="Repetir pedido" FontWeight="SemiBold" FontSize="13"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                    </Button>
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,8"
                                 Visibility="{Binding IsCreatingVersion, Converter={StaticResource BoolToVis}}"/>
                    <Button Style="{StaticResource SecondaryButton}"
                            Height="42" Margin="0,0,0,8" Padding="0"
                            Command="{Binding ShowInExplorerCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="Mostrar en el Explorador" FontWeight="SemiBold" FontSize="13"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource DangerButton}"
                            Height="42" Padding="0"
                            Command="{Binding DeleteFileCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Eliminar archivo" FontWeight="SemiBold" FontSize="13"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
