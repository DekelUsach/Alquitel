<UserControl x:Class="Alquitel.UI.Views.BudgetBuilderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Alquitel.UI.Converters"
             xmlns:helpers="clr-namespace:Alquitel.UI.Helpers">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:ProductButtonTextConverter x:Key="ProductButtonTextConverter"/>
        <conv:ProductButtonBackgroundConverter x:Key="ProductButtonBackgroundConverter"/>
        <conv:ProductRemoveButtonVisibilityConverter x:Key="ProductRemoveButtonVisibilityConverter"/>
        <conv:StripTagsConverter x:Key="StripTagsConverter"/>
        <helpers:BindingProxy x:Key="Proxy" Data="{Binding}"/>

        <!-- Segmento del selector de vista (Presupuesto / Orden de Trabajo) -->
        <Style x:Key="SegmentButtonBase" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Modifiers="Control" Key="Z" Command="{Binding UndoCartCommand}"/>
    </UserControl.InputBindings>

    <Grid Margin="28,24,28,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════ IZQUIERDA: CATÁLOGO ═══════════════ -->
        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Título de sección -->
            <TextBlock Grid.Row="0" Text="Catálogo" Style="{StaticResource PageTitle}" FontSize="22"
                       Margin="4,2,0,14"/>

            <!-- Buscador -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <TextBox Height="42" Padding="36,10,14,10"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               Foreground="{DynamicResource MutedTextBrush}"
                               VerticalAlignment="Center" Margin="14,0,0,0"
                               IsHitTestVisible="False"/>
                    <TextBlock Text="Buscar equipamiento"
                               Foreground="{DynamicResource MutedTextBrush}" FontSize="12"
                               VerticalAlignment="Center" Margin="38,0,0,0"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" Height="42" Width="42" Padding="0"
                        ToolTip="Armar pedido desde texto" Command="{Binding ParseSmartSearchCommand}">
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="15"/>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Height="42" Width="42" Padding="0"
                        ToolTip="Mostrar/Ocultar input de texto" Command="{Binding ToggleSmartSearchInputCommand}">
                    <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="15"/>
                </Button>
            </Grid>

            <!-- Panel de búsqueda inteligente -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,12"
                    Visibility="{Binding IsSmartSearchVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   Foreground="{DynamicResource SecondaryColorBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Pedido automático" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Pegá un párrafo con productos y cantidades. Luego tocá la lupa para armar el pedido."
                               TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,10"/>
                    <TextBox Height="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top" Padding="12,8"
                             Text="{Binding SmartSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Border>

            <!-- Lista de productos -->
            <ListBox Grid.Row="3" ItemsSource="{Binding AvailableProducts}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingStackPanel.IsVirtualizing="True">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="16,14" Margin="2,4,2,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="{Binding Description, Converter={StaticResource StripTagsConverter}}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <Grid Grid.Row="1" Margin="0,0,0,12">
                                    <Border Style="{StaticResource Chip}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Category}" Style="{StaticResource ChipText}"/>
                                    </Border>
                                    <TextBlock Text="{Binding BasePrice, StringFormat='{}{0:C}'}"
                                               FontSize="15" Foreground="{DynamicResource SecondaryColorBrush}" FontWeight="Bold"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Height="36" Margin="0"
                                            Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Content>
                                            <MultiBinding Converter="{StaticResource ProductButtonTextConverter}">
                                                <Binding/>
                                                <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                <Binding Path="DataContext.SelectionVersion" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                            </MultiBinding>
                                        </Button.Content>
                                        <Button.Background>
                                            <MultiBinding Converter="{StaticResource ProductButtonBackgroundConverter}">
                                                <Binding/>
                                                <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                <Binding Path="DataContext.SelectionVersion" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                            </MultiBinding>
                                        </Button.Background>
                                    </Button>

                                    <Button Grid.Column="1" Width="36" Height="36" Margin="6,0,0,0"
                                            Foreground="White" Background="{DynamicResource DangerBrush}" BorderThickness="0"
                                            FontSize="16" FontWeight="Bold" Cursor="Hand"
                                            ToolTip="Quitar una unidad"
                                            Command="{Binding DataContext.RemoveProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Visibility>
                                            <MultiBinding Converter="{StaticResource ProductRemoveButtonVisibilityConverter}">
                                                <Binding/>
                                                <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                <Binding Path="IsMouseOver" RelativeSource="{RelativeSource AncestorType=Border}"/>
                                                <Binding Path="DataContext.SelectionVersion" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                            </MultiBinding>
                                        </Button.Visibility>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <TextBlock Text="&#x2212;" FontSize="16" FontWeight="Bold"/>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- ═══════════════ DERECHA: EDITOR DE ORDEN ═══════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- DATOS DEL PEDIDO -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="24,20" Margin="0,0,0,14">
                <StackPanel>
                    <!-- Fila 1: Cliente -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.8*"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <TextBlock Text="Buscar cliente" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Height="42"
                                      ItemsSource="{Binding KnownClients}"
                                      SelectedItem="{Binding SelectedClient, Mode=TwoWay}"
                                      DisplayMemberPath="CompanyName"
                                      TextSearch.TextPath="CompanyName"
                                      IsEditable="True"
                                      IsTextSearchCaseSensitive="False"
                                      ToolTip="Escribí el nombre de un cliente registrado para autocompletar sus datos"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,14,0">
                            <TextBlock Text="CUIT (autocompleta)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Height="42" Text="{Binding CuitInput, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,14,0">
                            <TextBlock Text="Empresa / Cliente" Style="{StaticResource FieldLabel}"/>
                            <TextBox Height="42" Text="{Binding CurrentOrder.Client.CompanyName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Nº Presupuesto" Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="46"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Height="42"
                                         Text="{Binding CurrentOrder.BudgetNumber, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Height="42" Width="42"
                                        Padding="0" Margin="4,0,0,0"
                                        Command="{Binding CreateNewVersionCommand}"
                                        ToolTip="Crear nueva versión (rama) de este presupuesto: 31294 → 31294/2. La versión anterior no se modifica.">
                                    <TextBlock Text="&#xE8F4;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Fila 2: Evento -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.8*"/>
                            <ColumnDefinition Width="0.6*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1.0*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <TextBlock Text="Fecha del Evento (desde / hasta)" Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <DatePicker Grid.Column="0" Height="42"
                                            SelectedDate="{Binding CurrentOrder.EventDate, UpdateSourceTrigger=PropertyChanged}"
                                            ToolTip="Inicio del evento"/>
                                <DatePicker Grid.Column="2" Height="42"
                                            SelectedDate="{Binding CurrentOrder.EventEndDate, UpdateSourceTrigger=PropertyChanged}"
                                            ToolTip="Fin del evento (opcional: dejar vacío si es de un solo día). En el documento sale en palabras: 'del 14 de abril al 15 de mayo'."/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,14,0">
                            <TextBlock Text="Días" Style="{StaticResource FieldLabel}"/>
                            <TextBox Height="42" Text="{Binding EventDays, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,14,0">
                            <TextBlock Text="Lugar del Evento" Style="{StaticResource FieldLabel}"/>
                            <TextBox Height="42" Text="{Binding CurrentOrder.Location.Name, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Margin="0,0,14,0">
                            <TextBlock Text="Administrador" Style="{StaticResource FieldLabel}"/>
                            <TextBox Height="42" Text="{Binding CurrentOrder.AdminName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Estado" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Height="42"
                                      ItemsSource="{Binding StatusOptions}"
                                      SelectedValue="{Binding CurrentOrder.Status, Mode=TwoWay}"
                                      SelectedValuePath="Value"
                                      DisplayMemberPath="Label"
                                      ToolTip="Estado del presupuesto (se guarda con la orden)"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- SELECTOR DE VISTA (segmented control) + DESHACER -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Border Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="4" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding SetCommercialViewCommand}" Content="Presupuesto Comercial">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SegmentButtonBase}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTechnicalView}" Value="False">
                                            <Setter Property="Background" Value="{DynamicResource SecondaryColorBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Command="{Binding SetTechnicalViewCommand}" Content="Orden de Trabajo" Margin="4,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SegmentButtonBase}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTechnicalView}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SecondaryColorBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource GhostButton}" Height="38" HorizontalAlignment="Right"
                        Command="{Binding UndoCartCommand}"
                        ToolTip="Deshacer último cambio de productos del carrito (Ctrl+Z)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Deshacer" VerticalAlignment="Center" FontSize="12"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- TABLA DE ITEMS -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="24,16">
                <DataGrid ItemsSource="{Binding SelectedItems}" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          RowDetailsVisibilityMode="Collapsed"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          RowHeight="56">
                    <DataGrid.Columns>
                        <!-- §2 Disponibilidad: ⚠ cuando el pedido supera el stock libre para la fecha -->
                        <DataGridTemplateColumn Header="" Width="34" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}"
                                               FontSize="14" Foreground="{DynamicResource WarningBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               ToolTip="Stock insuficiente: este producto ya está comprometido en otras órdenes activas para la fecha del evento."
                                               Visibility="{Binding HasStockConflict, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="EQUIPAMIENTO" Binding="{Binding Product.Description, Converter={StaticResource StripTagsConverter}}" Width="3*" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="Margin" Value="4,0,0,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="CANT." Binding="{Binding Quantity}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="DÍAS" Binding="{Binding Dias}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="MEDIDA SOLICITADA" Binding="{Binding RequestedMeasure}" Width="160">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4,0,0,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox">
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="PRECIO UNIT." Binding="{Binding UnitPrice, StringFormat='{}{0:C}'}" Width="130"
                                            Visibility="{Binding Data.CommercialColumnsVisibility, Source={StaticResource Proxy}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="0,0,6,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox">
                                    <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="SUBTOTAL" Binding="{Binding Total, Mode=OneWay, StringFormat='{}{0:C}'}" Width="140" IsReadOnly="True"
                                            Visibility="{Binding Data.CommercialColumnsVisibility, Source={StaticResource Proxy}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Margin" Value="0,0,6,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            ToolTip="Quitar del pedido"
                                            Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                   Foreground="{DynamicResource DangerBrush}"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- PIE: TOTAL + GENERAR -->
            <Grid Grid.Row="3" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20,10"
                        VerticalAlignment="Center"
                        Visibility="{Binding CommercialColumnsVisibility}">
                    <StackPanel>
                        <TextBlock Text="TOTAL ESTIMADO" FontWeight="Bold" FontSize="10"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBlock Text="{Binding FinalBudget, Mode=OneWay, StringFormat={}{0:C2}, FallbackValue=$0.00, TargetNullValue=$0.00}"
                                   FontWeight="Black" FontSize="22" Margin="0,2,0,0"
                                   Foreground="{DynamicResource SecondaryColorBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Botones de generación -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Height="46" Style="{StaticResource PrimaryButton}" Padding="18,0"
                            Command="{Binding GenerateBudgetCommand}"
                            Visibility="{Binding CommercialColumnsVisibility}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Generar Presupuesto" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Height="46" Style="{StaticResource BrandButton}" Padding="18,0" Margin="10,0"
                            Command="{Binding GenerateOFCommand}"
                            Visibility="{Binding CommercialColumnsVisibility}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Generar O. Facturación" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Height="46" Style="{StaticResource SuccessButton}" Padding="18,0"
                            Command="{Binding GenerateOTCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9F5;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Generar O. Trabajo" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
