<UserControl x:Class="Alquitel.UI.Views.WorkOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="32,26,32,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Órdenes de Trabajo" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Documentos técnicos para el armado de equipos. Seleccioná una orden para verla."
                           Style="{StaticResource PageSubtitle}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                    Height="42" Padding="16,0" VerticalAlignment="Center"
                    Command="{Binding RefreshCommand}" ToolTip="Recargar lista">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Actualizar" FontWeight="SemiBold" FontSize="13"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Status -->
        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}"
                   FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                   Margin="4,0,0,10"/>

        <!-- Master / detail -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Lista de OT -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBox Height="40"
                                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="38,10,14,10"/>
                        <TextBlock Text="&#xE71E;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   VerticalAlignment="Center" Margin="14,0,0,0"
                                   IsHitTestVisible="False"/>
                    </Grid>

                    <ListBox Grid.Row="1" ItemsSource="{Binding FilesView}"
                             SelectedItem="{Binding SelectedFile}"
                             ItemContainerStyle="{StaticResource NavListItem}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding ModifiedFormatted}" FontSize="11"
                                               Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Vista previa -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding SelectedFile.FileName, FallbackValue='Vista previa'}"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource GhostDangerButton}"
                                    Height="40" Padding="14,0" Margin="0,0,8,0"
                                    Command="{Binding DeleteFileCommand}"
                                    ToolTip="Eliminar este documento de la carpeta de OT">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Eliminar" FontWeight="SemiBold" FontSize="13"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PrimaryButton}"
                                    Height="40" Padding="16,0"
                                    Command="{Binding OpenFileCommand}"
                                    ToolTip="Abre el documento original en Word">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Abrir en Word" FontWeight="SemiBold" FontSize="13"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="4"
                                 VerticalAlignment="Top"
                                 Visibility="{Binding IsLoadingPreview, Converter={StaticResource BoolToVis}}"/>

                    <!-- Estado vacío -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedFile}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="&#xE9F5;" Style="{StaticResource EmptyStateIcon}"/>
                        <TextBlock Text="Elegí una orden de trabajo" Style="{StaticResource EmptyStateTitle}"/>
                        <TextBlock Text="Seleccioná un documento de la lista de la izquierda para ver su contenido acá."
                                   Style="{StaticResource EmptyStateHint}" MaxWidth="320"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedFile}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <TextBox Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 BorderThickness="0" Background="Transparent"
                                 FontFamily="Consolas" FontSize="13"
                                 Padding="4"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
