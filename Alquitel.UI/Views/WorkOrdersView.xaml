<UserControl x:Class="Alquitel.UI.Views.WorkOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════════
         ÓRDENES DE TRABAJO · "Archivo y mesa de lectura"
         A la izquierda un archivo plano de documentos (sin chrome de tarjeta:
         separación por espacio). A la derecha una mesa de lectura: el
         documento seleccionado se apoya como hoja sobre un fondo rebajado,
         con su barra de acciones arriba. La metáfora es física — el armador
         busca el papel de su evento y lo lee.
         ═══════════════════════════════════════════════════════════════════ -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="32,26,32,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ ENCABEZADO ═══════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Órdenes de trabajo" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Documentos técnicos para el armado de equipos, leídos directo de la carpeta de OT."
                           Style="{StaticResource PageSubtitle}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="40" Height="40"
                    VerticalAlignment="Center"
                    Command="{Binding RefreshCommand}" ToolTip="Releer la carpeta de OT"
                    AutomationProperties.Name="Recargar órdenes de trabajo">
                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
            </Button>
        </Grid>

        <!-- ═══════════ ARCHIVO | MESA DE LECTURA ═══════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Archivo: lista plana, sin tarjeta contenedora -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <TextBox Height="40" Padding="36,10,14,10"
                             Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               Foreground="{DynamicResource MutedTextBrush}"
                               VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False"/>
                    <TextBlock Text="Buscar orden de trabajo" FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}"
                               VerticalAlignment="Center" Margin="38,0,0,0" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FilterText}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Estado vacío del archivo -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,40">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilesView.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="&#xE9F5;" Style="{StaticResource EmptyStateIcon}"/>
                    <TextBlock Text="Archivo vacío" Style="{StaticResource EmptyStateTitle}"/>
                    <TextBlock Text="No hay documentos en la carpeta de OT que coincidan con la búsqueda."
                               Style="{StaticResource EmptyStateHint}" MaxWidth="250"/>
                </StackPanel>

                <ListBox Grid.Row="1" ItemsSource="{Binding FilesView}"
                         SelectedItem="{Binding SelectedFile}"
                         ItemContainerStyle="{StaticResource NavListItem}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Lomo del documento: banda vertical, no ícono repetido -->
                                <Border Grid.Column="0" Width="4" CornerRadius="2" Margin="2,2,12,2"
                                        Background="{DynamicResource AccentSoftBrush}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding ModifiedFormatted}" FontSize="11"
                                               Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="2" Text="{Binding StatusMessage}"
                           FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                           Margin="4,10,0,0" TextWrapping="Wrap"/>
            </Grid>

            <!-- Mesa de lectura: fondo rebajado donde se apoya la hoja -->
            <Border Grid.Column="2" Background="{DynamicResource SurfaceAltBrush}"
                    CornerRadius="14" BorderThickness="1"
                    BorderBrush="{DynamicResource BorderBrush}">
                <Grid>
                    <!-- Nada seleccionado: mesa vacía -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedFile}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="&#xE736;" Style="{StaticResource EmptyStateIcon}"/>
                        <TextBlock Text="La mesa está libre" Style="{StaticResource EmptyStateTitle}"/>
                        <TextBlock Text="Elegí un documento del archivo de la izquierda para apoyarlo acá y leerlo."
                                   Style="{StaticResource EmptyStateHint}" MaxWidth="320"/>
                    </StackPanel>

                    <!-- Documento apoyado -->
                    <Grid Margin="28,20,28,24">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedFile}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Barra del documento: nombre + fecha + acciones -->
                        <Grid Grid.Row="0" Margin="4,0,4,16" MaxWidth="860">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{Binding SelectedFile.FileName}"
                                           FontSize="15" FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding SelectedFile.ModifiedFormatted}"
                                           FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource GhostDangerButton}"
                                        Height="38" Padding="14,0" Margin="0,0,8,0"
                                        Command="{Binding DeleteFileCommand}"
                                        ToolTip="Eliminar este documento de la carpeta de OT">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                   VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="Eliminar" FontWeight="SemiBold" FontSize="12.5"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource PrimaryButton}"
                                        Height="38" Padding="16,0"
                                        Command="{Binding OpenFileCommand}"
                                        ToolTip="Abre el documento original en Word">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                   VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="Abrir en Word" FontWeight="SemiBold" FontSize="12.5"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- La hoja -->
                        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                                CornerRadius="4" MaxWidth="860"
                                BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                Effect="{StaticResource CardShadow}">
                            <Grid>
                                <ProgressBar IsIndeterminate="True" Height="3"
                                             VerticalAlignment="Top" Margin="1,1,1,0"
                                             Visibility="{Binding IsLoadingPreview, Converter={StaticResource BoolToVis}}"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
                                    <TextBox Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True"
                                             TextWrapping="Wrap" AcceptsReturn="True"
                                             BorderThickness="0" Background="Transparent"
                                             FontFamily="Consolas" FontSize="13"
                                             Padding="36,28"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
