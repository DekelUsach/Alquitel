<UserControl x:Class="Alquitel.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="40,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <TextBlock Text="Configuración" FontSize="34" FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}"/>
            <TextBlock Text="Rutas de plantillas y carpetas de destino para la generación de documentos."
                       FontSize="14" Foreground="{DynamicResource MutedTextBrush}" Margin="0,6,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 3-column card layout -->
                <UniformGrid Columns="3" Margin="0,0,0,24">

                    <!-- PRESUPUESTOS -->
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="20" Padding="22,20"
                            Margin="0,0,12,0" Effect="{StaticResource StandardShadow}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <Border Width="8" Height="8" CornerRadius="4"
                                        Background="{DynamicResource SecondaryColorBrush}"
                                        VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Presupuestos" FontWeight="Bold" FontSize="15"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>

                            <TextBlock Text="Carpeta destino" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Height="40" FontSize="11"
                                         Text="{Binding PresupuestosFolder, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Style="{StaticResource DarkPillButton}" Height="40" Width="40" Padding="0" Margin="4,0,0,0"
                                        ToolTip="Seleccionar carpeta" Command="{Binding BrowsePresupuestosFolderCommand}">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Button>
                            </Grid>

                            <TextBlock Text="Plantilla (.docx)" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Height="40" FontSize="11"
                                         Text="{Binding PresupuestosTemplate, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Style="{StaticResource DarkPillButton}" Height="40" Width="40" Padding="0" Margin="4,0,0,0"
                                        ToolTip="Seleccionar plantilla" Command="{Binding BrowsePresupuestosTemplateCommand}">
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- OF -->
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="20" Padding="22,20"
                            Margin="6,0,6,0" Effect="{StaticResource StandardShadow}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <Border Width="8" Height="8" CornerRadius="4"
                                        Background="{DynamicResource PrimaryBrush}"
                                        VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Orden de Facturación" FontWeight="Bold" FontSize="15"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>

                            <TextBlock Text="Carpeta destino" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Height="40" FontSize="11"
                                         Text="{Binding OfFolder, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Style="{StaticResource DarkPillButton}" Height="40" Width="40" Padding="0" Margin="4,0,0,0"
                                        ToolTip="Seleccionar carpeta" Command="{Binding BrowseOfFolderCommand}">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Button>
                            </Grid>

                            <TextBlock Text="Plantilla (.docx)" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Height="40" FontSize="11"
                                         Text="{Binding OfTemplate, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Style="{StaticResource DarkPillButton}" Height="40" Width="40" Padding="0" Margin="4,0,0,0"
                                        ToolTip="Seleccionar plantilla" Command="{Binding BrowseOfTemplateCommand}">
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- OT -->
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="20" Padding="22,20"
                            Margin="12,0,0,0" Effect="{StaticResource StandardShadow}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <Border Width="8" Height="8" CornerRadius="4"
                                        Background="#27AE60"
                                        VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Orden de Trabajo" FontWeight="Bold" FontSize="15"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>

                            <TextBlock Text="Carpeta destino" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Height="40" FontSize="11"
                                         Text="{Binding OtFolder, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Style="{StaticResource DarkPillButton}" Height="40" Width="40" Padding="0" Margin="4,0,0,0"
                                        ToolTip="Seleccionar carpeta" Command="{Binding BrowseOtFolderCommand}">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Button>
                            </Grid>

                            <TextBlock Text="Plantilla (.docx)" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Height="40" FontSize="11"
                                         Text="{Binding OtTemplate, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Style="{StaticResource DarkPillButton}" Height="40" Width="40" Padding="0" Margin="4,0,0,0"
                                        ToolTip="Seleccionar plantilla" Command="{Binding BrowseOtTemplateCommand}">
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Save button + status -->
                <StackPanel HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Button Style="{StaticResource DarkPillButton}" Height="48" Width="260"
                            Command="{Binding SaveSettingsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="GUARDAR CONFIGURACIÓN" FontSize="13" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="13" Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource SecondaryColorBrush}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
