<UserControl x:Class="Alquitel.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Título de sección (columna izquierda) -->
        <Style x:Key="PrefTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>

        <Style x:Key="PrefHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,24,0"/>
            <Setter Property="LineHeight" Value="18"/>
        </Style>

        <!-- Etiqueta de subgrupo de documento -->
        <Style x:Key="DocGroupLabel" TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="BrowseButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ ENCABEZADO ═══════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Configuración" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Rutas locales, generación de documentos, servidor y equipo de trabajo."
                           Style="{StaticResource PageSubtitle}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusMessage}" FontSize="12.5"
                           Foreground="{DynamicResource SecondaryColorBrush}"
                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                <Button Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveSettingsCommand}"
                        AutomationProperties.Name="Guardar configuración">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Guardar configuración" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel MaxWidth="1080" HorizontalAlignment="Left" Margin="0,4,12,20">

                <!-- ═══════════ SECCIÓN 1: RUTAS DE DOCUMENTOS ═══════════ -->
                <Border Style="{StaticResource Card}" Padding="24,20" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           Foreground="{DynamicResource SecondaryColorBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Documentos" Style="{StaticResource PrefTitle}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource PrefHint}"
                                       Text="Dónde se guarda cada tipo de documento y qué plantilla .docx usa el motor de Word para generarlo."/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <!-- Presupuestos -->
                            <TextBlock Text="Presupuestos · comercial" Style="{StaticResource DocGroupLabel}"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Height="40" FontSize="12.5"
                                         ToolTip="Carpeta destino de los presupuestos"
                                         AutomationProperties.Name="Carpeta de presupuestos"
                                         Text="{Binding PresupuestosFolder, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Style="{StaticResource BrowseButton}"
                                        ToolTip="Seleccionar carpeta de presupuestos"
                                        AutomationProperties.Name="Examinar carpeta de presupuestos"
                                        Command="{Binding BrowsePresupuestosFolderCommand}">
                                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="13"/>
                                </Button>
                            </Grid>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Height="40" FontSize="12.5"
                                         ToolTip="Plantilla .docx de presupuestos"
                                         AutomationProperties.Name="Plantilla de presupuestos"
                                         Text="{Binding PresupuestosTemplate, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Style="{StaticResource BrowseButton}"
                                        ToolTip="Seleccionar plantilla de presupuestos"
                                        AutomationProperties.Name="Examinar plantilla de presupuestos"
                                        Command="{Binding BrowsePresupuestosTemplateCommand}">
                                    <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="13"/>
                                </Button>
                            </Grid>

                            <!-- OF -->
                            <TextBlock Text="Orden de facturación · administrativo" Style="{StaticResource DocGroupLabel}"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Height="40" FontSize="12.5"
                                         ToolTip="Carpeta destino de las OF"
                                         AutomationProperties.Name="Carpeta de órdenes de facturación"
                                         Text="{Binding OfFolder, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Style="{StaticResource BrowseButton}"
                                        ToolTip="Seleccionar carpeta de OF"
                                        AutomationProperties.Name="Examinar carpeta de órdenes de facturación"
                                        Command="{Binding BrowseOfFolderCommand}">
                                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="13"/>
                                </Button>
                            </Grid>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Height="40" FontSize="12.5"
                                         ToolTip="Plantilla .docx de las OF"
                                         AutomationProperties.Name="Plantilla de órdenes de facturación"
                                         Text="{Binding OfTemplate, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Style="{StaticResource BrowseButton}"
                                        ToolTip="Seleccionar plantilla de OF"
                                        AutomationProperties.Name="Examinar plantilla de órdenes de facturación"
                                        Command="{Binding BrowseOfTemplateCommand}">
                                    <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="13"/>
                                </Button>
                            </Grid>

                            <!-- OT -->
                            <TextBlock Text="Orden de trabajo · técnico" Style="{StaticResource DocGroupLabel}"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Height="40" FontSize="12.5"
                                         ToolTip="Carpeta destino de las OT"
                                         AutomationProperties.Name="Carpeta de órdenes de trabajo"
                                         Text="{Binding OtFolder, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Style="{StaticResource BrowseButton}"
                                        ToolTip="Seleccionar carpeta de OT"
                                        AutomationProperties.Name="Examinar carpeta de órdenes de trabajo"
                                        Command="{Binding BrowseOtFolderCommand}">
                                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="13"/>
                                </Button>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Height="40" FontSize="12.5"
                                         ToolTip="Plantilla .docx de las OT"
                                         AutomationProperties.Name="Plantilla de órdenes de trabajo"
                                         Text="{Binding OtTemplate, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Style="{StaticResource BrowseButton}"
                                        ToolTip="Seleccionar plantilla de OT"
                                        AutomationProperties.Name="Examinar plantilla de órdenes de trabajo"
                                        Command="{Binding BrowseOtTemplateCommand}">
                                    <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="13"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══════════ SECCIÓN 2: GENERACIÓN ═══════════ -->
                <Border Style="{StaticResource Card}" Padding="24,20" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           Foreground="{DynamicResource SecondaryColorBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Generación" Style="{StaticResource PrefTitle}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource PrefHint}"
                                       Text="Comportamiento del motor de documentos al crear cada archivo comercial o técnico."/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ModernCheckBox}"
                                  VerticalAlignment="Top"
                                  IsChecked="{Binding ExportPdf}"
                                  ToolTip="Además del .docx, Word genera un .pdf en la misma carpeta"
                                  AutomationProperties.Name="Exportar también una copia en PDF">
                            <StackPanel>
                                <TextBlock Text="Exportar también una copia en PDF"
                                           FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="Al generar cada presupuesto u orden se crea automáticamente un archivo .pdf junto al .docx."
                                           FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </CheckBox>
                    </Grid>
                </Border>

                <!-- ═══════════ SECCIÓN 3: IA EXTERNA ═══════════ -->
                <!-- Consentimiento explícito: es la única preferencia que habilita el envío
                     de texto redactado a Pollinations. Viene de codex/core-reliability; acá
                     queda con el diseño de tarjeta de antigravity/quality-ui. -->
                <Border Style="{StaticResource Card}" Padding="24,20" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           Foreground="{DynamicResource SecondaryColorBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="IA externa" Style="{StaticResource PrefTitle}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource PrefHint}"
                                       Text="Controla el procesamiento opcional mediante Pollinations. Sin consentimiento, el pedido automático usa solo el motor local."/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ModernCheckBox}"
                                  VerticalAlignment="Top"
                                  IsChecked="{Binding ExternalAiProcessingEnabled}"
                                  AutomationProperties.Name="Permitir procesamiento con IA externa">
                            <StackPanel>
                                <TextBlock Text="Permitir procesamiento con IA externa"
                                           FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="Antes de enviar, Alquitel redacta CUIT, DNI, email, teléfono, domicilio y datos bancarios. Los textos se procesan fuera del equipo."
                                           FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </CheckBox>
                    </Grid>
                </Border>

                <!-- ═══════════ SECCIÓN 4: SERVIDOR COMPARTIDO ═══════════ -->
                <Border Style="{StaticResource Card}" Padding="24,20" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="&#xE753;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           Foreground="{DynamicResource SecondaryColorBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Servidor compartido" Style="{StaticResource PrefTitle}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource PrefHint}"
                                       Text="Base de datos PostgreSQL (Supabase) compartida por todo el equipo."/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding RemoteStatusMessage}" FontSize="12.5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,14"/>
                            <WrapPanel>
                                <Button Style="{StaticResource SecondaryButton}"
                                        Command="{Binding RefreshRemoteStatusCommand}" Margin="0,0,8,8"
                                        AutomationProperties.Name="Probar conexión con servidor">
                                    <Button.Content>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Probar conexión"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTestingConnection}" Value="True">
                                                            <Setter Property="Text" Value="Probando…"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button.Content>
                                </Button>
                                <Button Content="Subir datos locales al servidor" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding PushLocalDataCommand}" Margin="0,0,0,8"
                                        AutomationProperties.Name="Subir datos locales al servidor"
                                        ToolTip="Carga inicial: sube todos los datos de la base SQLite de esta máquina al servidor. Ejecutar una sola vez desde la máquina con el histórico."/>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══════════ SECCIÓN 5: BACKUPS (SOLO MODO SQLITE) ═══════════ -->
                <Border Style="{StaticResource Card}" Padding="24,20" Margin="0,0,0,16"
                        Visibility="{Binding CanRestoreBackups, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="&#xE777;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           Foreground="{DynamicResource SecondaryColorBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Copias de seguridad" Style="{StaticResource PrefTitle}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource PrefHint}"
                                       Text="La app copia la base cada 6 horas y conserva las últimas 20. Ante un desastre, elegí una copia y restaurala."/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <Border Style="{StaticResource CardInner}" Padding="4" Margin="0,0,0,12" MaxHeight="180">
                                <ListBox ItemsSource="{Binding Backups}"
                                         SelectedItem="{Binding SelectedBackup, Mode=TwoWay}"
                                         BorderThickness="0" Background="Transparent"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         AutomationProperties.Name="Lista de copias de seguridad">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayLabel}" FontSize="12.5" Padding="8,6"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                            <WrapPanel>
                                <Button Content="Actualizar lista" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding RefreshBackupsCommand}" Margin="0,0,8,8"
                                        AutomationProperties.Name="Actualizar lista de copias de seguridad"/>
                                <Button Content="Restaurar seleccionado" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding RestoreSelectedBackupCommand}" Margin="0,0,0,8"
                                        AutomationProperties.Name="Restaurar copia seleccionada"
                                        ToolTip="Reemplaza la base actual por la copia elegida (la actual se preserva como Alquitel_PreRestore_*)."/>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══════════ SECCIÓN 6: PLANTILLAS EN LA NUBE (SOLO ADMIN) ═══════════ -->
                <Border Style="{StaticResource Card}" Padding="24,20" Margin="0,0,0,16"
                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           Foreground="{DynamicResource SecondaryColorBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Plantillas en la nube" Style="{StaticResource PrefTitle}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource PrefHint}"
                                       Text="Plantillas .docx centralizadas en Supabase Storage. Al publicar, todos los puestos usan esa versión (con cache local para trabajar sin internet)."/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding CloudTemplatesStatusMessage}" FontSize="12.5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,14"/>
                            <WrapPanel>
                                <Button Content="Publicar plantilla de Presupuesto…" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding PublishPresupuestoTemplateCommand}" Margin="0,0,8,8"
                                        AutomationProperties.Name="Publicar plantilla oficial de presupuesto"
                                        ToolTip="Sube un .docx como plantilla oficial de presupuestos para todo el equipo"/>
                                <Button Content="Publicar OF…" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding PublishOfTemplateCommand}" Margin="0,0,8,8"
                                        AutomationProperties.Name="Publicar plantilla oficial de OF"/>
                                <Button Content="Publicar OT…" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding PublishOtTemplateCommand}" Margin="0,0,8,8"
                                        AutomationProperties.Name="Publicar plantilla oficial de OT"/>
                                <Button Content="Actualizar estado" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding RefreshCloudTemplatesStatusCommand}" Margin="0,0,0,8"
                                        AutomationProperties.Name="Actualizar estado de plantillas remotas"/>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══════════ SECCIÓN 7: USUARIOS Y ROLES ═══════════ -->
                <Border Style="{StaticResource Card}" Padding="24,20" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="&#xE716;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           Foreground="{DynamicResource SecondaryColorBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Usuarios y roles" Style="{StaticResource PrefTitle}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource PrefHint}"
                                       Text="Admin: acceso total. Vendedor: presupuestos, clientes y ubicaciones. Armador: solo ve y previsualiza las Órdenes de Trabajo (depósito)."/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      MaxHeight="240" RowHeight="40" Margin="0,0,0,14"
                                      AutomationProperties.Name="Tabla de usuarios del sistema">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="NOMBRE" Binding="{Binding Name}" Width="2*"
                                                        ElementStyle="{StaticResource DataGridCellText}"/>
                                    <DataGridTextColumn Header="ROL" Binding="{Binding Role}" Width="*"
                                                        ElementStyle="{StaticResource DataGridCellTextMuted}"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Actividad del usuario seleccionado (solo informativo) -->
                            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10"
                                    Padding="14,10" Margin="0,0,0,14">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedUserStatsMessage}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                               Foreground="{DynamicResource SecondaryColorBrush}"
                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding SelectedUserStatsMessage}" FontSize="12.5"
                                               Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Alta -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Nombre" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Height="40" Text="{Binding NewUserName, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Nombre del nuevo usuario"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Text="Rol" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Height="40" SelectedIndex="{Binding NewUserRoleIndex}"
                                              AutomationProperties.Name="Rol del nuevo usuario">
                                        <ComboBoxItem Content="Vendedor"/>
                                        <ComboBoxItem Content="Admin"/>
                                        <ComboBoxItem Content="Armador"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                    <TextBlock Text="Contraseña inicial (opcional)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Height="40" Text="{Binding NewUserPassword, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Contraseña inicial del nuevo usuario"/>
                                </StackPanel>
                                <Button Grid.Column="3" Content="Agregar" Style="{StaticResource PrimaryButton}"
                                        VerticalAlignment="Bottom" Height="40"
                                        Command="{Binding AddUserCommand}"
                                        AutomationProperties.Name="Agregar usuario"/>
                            </Grid>

                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="Establecer contraseña al seleccionado" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding SetUserPasswordCommand}" Margin="0,0,8,8"
                                        AutomationProperties.Name="Establecer contraseña al usuario seleccionado"
                                        ToolTip="Abre un diálogo para definir o quitar la contraseña del usuario seleccionado en la lista."/>
                                <Button Content="Eliminar seleccionado" Style="{StaticResource GhostDangerButton}"
                                        Command="{Binding DeleteUserCommand}" Margin="0,0,0,8"
                                        AutomationProperties.Name="Eliminar usuario seleccionado"/>
                            </WrapPanel>

                            <!-- Edición del usuario seleccionado -->
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                                    Margin="0,14,0,0" Padding="0,16,0,0"
                                    Visibility="{Binding HasSelectedUser, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Editar usuario seleccionado" Style="{StaticResource DocGroupLabel}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Modificar nombre" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Height="40" Text="{Binding EditUserName, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Modificar nombre del usuario seleccionado"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                            <TextBlock Text="Modificar rol" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox Height="40" SelectedIndex="{Binding EditUserRoleIndex}"
                                                      AutomationProperties.Name="Modificar rol del usuario seleccionado">
                                                <ComboBoxItem Content="Vendedor"/>
                                                <ComboBoxItem Content="Admin"/>
                                                <ComboBoxItem Content="Armador"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                            <Button Content="Guardar cambios" Style="{StaticResource PrimaryButton}"
                                                    Height="40" Margin="0,0,8,0"
                                                    Command="{Binding UpdateUserCommand}"
                                                    AutomationProperties.Name="Guardar cambios de usuario"/>
                                            <Button Content="Cancelar" Style="{StaticResource SecondaryButton}"
                                                    Height="40"
                                                    Command="{Binding DeselectUserCommand}"
                                                    AutomationProperties.Name="Cancelar edición de usuario"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding UsersStatusMessage}" FontSize="12.5" Margin="0,10,0,0"
                                       Foreground="{DynamicResource SecondaryColorBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
