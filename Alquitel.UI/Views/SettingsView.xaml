<UserControl x:Class="Alquitel.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Ícono de sección con color propio por tipo de documento -->
        <Style x:Key="DocIconBox" TargetType="Border" BasedOn="{StaticResource SectionIconBox}"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ HEADER ═══════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="Configuración" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Rutas de plantillas y carpetas de destino para la generación de documentos."
                           Style="{StaticResource PageSubtitle}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Command="{Binding SaveSettingsCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Guardar Configuración" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1200" HorizontalAlignment="Left">

                <!-- ═══════════ TARJETAS DE DOCUMENTOS ═══════════ -->
                <UniformGrid Columns="3" Margin="0,0,0,20">

                    <!-- PRESUPUESTOS -->
                    <Border Style="{StaticResource Card}" Padding="22,20" Margin="0,0,14,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <Border Style="{StaticResource DocIconBox}">
                                    <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                               Foreground="{DynamicResource SecondaryColorBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Presupuestos" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Documento comercial" FontSize="11"
                                               Foreground="{DynamicResource MutedTextBrush}" Margin="0,1,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="Carpeta destino" Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="44"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Height="40" FontSize="11"
                                         Text="{Binding PresupuestosFolder, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Height="40" Width="40"
                                        Padding="0" Margin="4,0,0,0"
                                        ToolTip="Seleccionar carpeta" Command="{Binding BrowsePresupuestosFolderCommand}">
                                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="13"/>
                                </Button>
                            </Grid>

                            <TextBlock Text="Plantilla (.docx)" Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="44"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Height="40" FontSize="11"
                                         Text="{Binding PresupuestosTemplate, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Height="40" Width="40"
                                        Padding="0" Margin="4,0,0,0"
                                        ToolTip="Seleccionar plantilla" Command="{Binding BrowsePresupuestosTemplateCommand}">
                                    <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="13"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ORDEN DE FACTURACIÓN -->
                    <Border Style="{StaticResource Card}" Padding="22,20" Margin="7,0,7,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <Border Style="{StaticResource DocIconBox}">
                                    <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Orden de Facturación" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Documento administrativo" FontSize="11"
                                               Foreground="{DynamicResource MutedTextBrush}" Margin="0,1,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="Carpeta destino" Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="44"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Height="40" FontSize="11"
                                         Text="{Binding OfFolder, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Height="40" Width="40"
                                        Padding="0" Margin="4,0,0,0"
                                        ToolTip="Seleccionar carpeta" Command="{Binding BrowseOfFolderCommand}">
                                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="13"/>
                                </Button>
                            </Grid>

                            <TextBlock Text="Plantilla (.docx)" Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="44"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Height="40" FontSize="11"
                                         Text="{Binding OfTemplate, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Height="40" Width="40"
                                        Padding="0" Margin="4,0,0,0"
                                        ToolTip="Seleccionar plantilla" Command="{Binding BrowseOfTemplateCommand}">
                                    <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="13"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ORDEN DE TRABAJO -->
                    <Border Style="{StaticResource Card}" Padding="22,20" Margin="14,0,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <Border Style="{StaticResource DocIconBox}">
                                    <TextBlock Text="&#xE9F5;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Orden de Trabajo" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Documento técnico" FontSize="11"
                                               Foreground="{DynamicResource MutedTextBrush}" Margin="0,1,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="Carpeta destino" Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="44"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Height="40" FontSize="11"
                                         Text="{Binding OtFolder, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Height="40" Width="40"
                                        Padding="0" Margin="4,0,0,0"
                                        ToolTip="Seleccionar carpeta" Command="{Binding BrowseOtFolderCommand}">
                                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="13"/>
                                </Button>
                            </Grid>

                            <TextBlock Text="Plantilla (.docx)" Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="44"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Height="40" FontSize="11"
                                         Text="{Binding OtTemplate, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Height="40" Width="40"
                                        Padding="0" Margin="4,0,0,0"
                                        ToolTip="Seleccionar plantilla" Command="{Binding BrowseOtTemplateCommand}">
                                    <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="13"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- ═══════════ OPCIONES DE GENERACIÓN ═══════════ -->
                <Border Style="{StaticResource Card}" Padding="22,20" Margin="0,0,0,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Style="{StaticResource DocIconBox}">
                                <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           Foreground="{DynamicResource WarningBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Opciones de Generación" Style="{StaticResource SectionTitle}"/>
                        </StackPanel>
                        <CheckBox Style="{StaticResource ModernCheckBox}"
                                  IsChecked="{Binding ExportPdf}"
                                  ToolTip="Además del .docx, Word genera un .pdf en la misma carpeta">
                            <StackPanel>
                                <TextBlock Text="Exportar también una copia en PDF"
                                           FontSize="13" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="Al generar cada documento se crea un .pdf junto al .docx."
                                           FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- ═══════════ SERVIDOR COMPARTIDO ═══════════ -->
                <Border Style="{StaticResource Card}" Padding="22,20" Margin="0,0,0,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Style="{StaticResource DocIconBox}">
                                <TextBlock Text="&#xE968;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           Foreground="{DynamicResource SecondaryColorBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Servidor compartido" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Base de datos PostgreSQL (Supabase) compartida por todo el equipo."
                                           FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="{Binding RemoteStatusMessage}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Probar conexión" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding RefreshRemoteStatusCommand}" Margin="0,0,10,0"/>
                            <Button Content="Subir datos locales al servidor" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding PushLocalDataCommand}"
                                    ToolTip="Carga inicial: sube todos los datos de la base SQLite de esta máquina al servidor. Ejecutar una sola vez desde la máquina con el histórico."/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══════════ PLANTILLAS EN LA NUBE (SOLO ADMIN) ═══════════ -->
                <Border Style="{StaticResource Card}" Padding="22,20" Margin="0,0,0,20"
                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Style="{StaticResource DocIconBox}">
                                <TextBlock Text="&#xE753;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           Foreground="{DynamicResource SecondaryColorBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Plantillas en la nube" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Plantilla .docx centralizada en Supabase Storage. Al publicar, todos los puestos de trabajo usan esta versión (con cache local para trabajar sin internet)."
                                           FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap" Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="{Binding CloudTemplatesStatusMessage}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Publicar plantilla de Presupuesto…" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding PublishPresupuestoTemplateCommand}" Margin="0,0,10,0"
                                    ToolTip="Sube un .docx como plantilla oficial de presupuestos para todo el equipo"/>
                            <Button Content="Publicar plantilla OF…" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding PublishOfTemplateCommand}" Margin="0,0,10,0"/>
                            <Button Content="Publicar plantilla OT…" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding PublishOtTemplateCommand}" Margin="0,0,10,0"/>
                            <Button Content="Actualizar estado" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding RefreshCloudTemplatesStatusCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══════════ USUARIOS Y ROLES ═══════════ -->
                <Border Style="{StaticResource Card}" Padding="22,20" Margin="0,0,0,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Style="{StaticResource DocIconBox}">
                                <TextBlock Text="&#xE716;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Usuarios y roles" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Admin: acceso total. Vendedor: presupuestos, clientes y ubicaciones (sin catálogo, reportes ni configuración)."
                                           FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  MaxHeight="240" RowHeight="38" Margin="0,0,0,14">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="NOMBRE" Binding="{Binding Name}" Width="2*"
                                                    ElementStyle="{StaticResource DataGridCellText}"/>
                                <DataGridTextColumn Header="ROL" Binding="{Binding Role}" Width="*"
                                                    ElementStyle="{StaticResource DataGridCellTextMuted}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Nombre" Style="{StaticResource FieldLabel}"/>
                                <TextBox Height="40" Text="{Binding NewUserName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="Rol" Style="{StaticResource FieldLabel}"/>
                                <ComboBox Height="40" SelectedIndex="{Binding NewUserRoleIndex}">
                                    <ComboBoxItem Content="Vendedor"/>
                                    <ComboBoxItem Content="Admin"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                <TextBlock Text="Contraseña (opcional)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Height="40" Text="{Binding NewUserPassword, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <Button Grid.Column="3" Content="Agregar" Style="{StaticResource SuccessButton}"
                                    VerticalAlignment="Bottom" Height="40"
                                    Command="{Binding AddUserCommand}"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Establecer contraseña al seleccionado" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding SetUserPasswordCommand}" Margin="0,0,10,0"
                                    ToolTip="Aplica el texto del campo Contraseña al usuario seleccionado en la lista. Vacío = quitar contraseña."/>
                            <Button Content="Archivar seleccionado" Style="{StaticResource GhostDangerButton}"
                                    Command="{Binding ArchiveUserCommand}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding UsersStatusMessage}" FontSize="12" Margin="0,10,0,0"
                                   Foreground="{DynamicResource SecondaryColorBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Estado -->
                <TextBlock Text="{Binding StatusMessage}" FontSize="13" Margin="0,4,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource SecondaryColorBrush}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
