<UserControl x:Class="Alquitel.UI.Views.OrderPoolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Alquitel.UI.Converters">

    <!-- ═══════════════════════════════════════════════════════════════════
         SEGUIMIENTO · "Bitácora de operaciones"
         Rail de estados a la izquierda (navegación por filtro, con contadores)
         y un libro mayor de órdenes a la derecha: filas de dos líneas con
         fecha como columna ancla, total en cifras tabulares y el cambio de
         estado inline. Sin DataGrid: el ojo recorre un registro, no una
         planilla.
         ═══════════════════════════════════════════════════════════════════ -->

    <UserControl.Resources>
        <conv:OrderStatusToBrushConverter x:Key="StatusToBrush"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>

        <!-- Fila del libro mayor: hairline inferior, hover sutil, sin selección -->
        <Style x:Key="LedgerRow" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="row" Background="Transparent"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="Background"
                                        Value="{DynamicResource DataRowHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Acciones de fila: invisibles hasta que el mouse entra a la fila -->
        <Style x:Key="RowActions" TargetType="StackPanel">
            <Setter Property="Opacity" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                             Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,26,32,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ ENCABEZADO ═══════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Seguimiento" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Todas las órdenes del sistema. El cambio de estado se guarda al instante."
                           Style="{StaticResource PageSubtitle}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Búsqueda en el header: siempre visible, sin robar espacio al registro -->
            <Grid Grid.Column="1" Width="300" VerticalAlignment="Center" Margin="0,0,8,0">
                <TextBox Height="40" Padding="36,10,14,10"
                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Buscar por número, cliente, lugar o creador"/>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13"
                           Foreground="{DynamicResource MutedTextBrush}"
                           VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False"/>
                <TextBlock Text="Buscar en las órdenes" FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}"
                           VerticalAlignment="Center" Margin="38,0,0,0" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilterText}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="40" Height="40"
                    VerticalAlignment="Center"
                    Command="{Binding RefreshCommand}" ToolTip="Recargar órdenes"
                    AutomationProperties.Name="Recargar órdenes">
                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
            </Button>
        </Grid>

        <!-- ═══════════ RAIL DE ESTADOS + LIBRO MAYOR ═══════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Rail: un lugar fijo para el filtro, con el pulso de cada estado -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Estados" Style="{StaticResource SectionLabel}"
                               Margin="12,8,0,10"/>

                    <ListBox Grid.Row="1" ItemsSource="{Binding FilterOptions}"
                             SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource NavListItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="8" Height="8" Margin="2,0,10,0"
                                             VerticalAlignment="Center"
                                             Fill="{Binding Key, Converter={StaticResource StatusToBrush}}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Typography.NumeralAlignment="Tabular"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               VerticalAlignment="Center" Margin="8,0,2,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="2" Style="{StaticResource GhostButton}" Height="34"
                            HorizontalAlignment="Stretch" Margin="4,8,4,2" FontSize="12"
                            Command="{Binding ClearFiltersCommand}"
                            ToolTip="Quitar la búsqueda y volver a «Todos»">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8E6;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Limpiar filtros" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Libro mayor -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Skeleton mientras carga (latencia en modo Supabase) -->
                <StackPanel Grid.Row="0" Margin="4,8"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource SkeletonRow}" Height="58"/>
                    <Border Style="{StaticResource SkeletonRow}" Height="58" Opacity="0.5"/>
                    <Border Style="{StaticResource SkeletonRow}" Height="58" Opacity="0.45"/>
                    <Border Style="{StaticResource SkeletonRow}" Height="58" Opacity="0.35"/>
                    <Border Style="{StaticResource SkeletonRow}" Height="58" Opacity="0.25"/>
                </StackPanel>

                <Border Grid.Row="0" Style="{StaticResource CardFadeIn}" Padding="6,2"
                        Visibility="{Binding IsLoading, Converter={StaticResource InvBoolToVis}}">
                    <Grid>
                        <!-- Estado vacío: sin órdenes que coincidan con filtro/búsqueda -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RowsView.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="&#xE9D5;" Style="{StaticResource EmptyStateIcon}"/>
                            <TextBlock Text="Nada por acá" Style="{StaticResource EmptyStateTitle}"/>
                            <TextBlock Text="Ninguna orden coincide con el estado o la búsqueda elegidos."
                                       Style="{StaticResource EmptyStateHint}" MaxWidth="300"/>
                        </StackPanel>

                        <ListBox ItemsSource="{Binding RowsView}"
                                 ItemContainerStyle="{StaticResource LedgerRow}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="14,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="58"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="112"/>
                                            <ColumnDefinition Width="176"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Fecha ancla: día grande, mes chico -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CreatedDate, StringFormat='{}{0:dd}'}"
                                                       FontFamily="{StaticResource AppDisplayFontFamily}"
                                                       FontSize="19" FontWeight="SemiBold"
                                                       Typography.NumeralAlignment="Tabular"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Text="{Binding CreatedDate, StringFormat='{}{0:MMM yy}'}"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource MutedTextBrush}"/>
                                        </StackPanel>

                                        <!-- Registro: número + cliente / evento + lugar -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,10,0">
                                            <TextBlock TextTrimming="CharacterEllipsis" FontSize="13.5">
                                                <Run Text="{Binding BudgetNumber, Mode=OneWay}" FontWeight="SemiBold"
                                                     Foreground="{DynamicResource TextBrush}"/>
                                                <Run Text="  ·  " Foreground="{DynamicResource MutedTextBrush}"/>
                                                <Run Text="{Binding ClientName, Mode=OneWay}"
                                                     Foreground="{DynamicResource TextBrush}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11.5" Margin="0,3,0,0"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding EventLabel, Mode=OneWay}"/>
                                                <Run Text="{Binding LocationName, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Creador -->
                                        <Border Grid.Column="2" Style="{StaticResource Chip}"
                                                VerticalAlignment="Center" Margin="0,0,12,0"
                                                ToolTip="Creado por">
                                            <TextBlock Text="{Binding AdminName}" Style="{StaticResource ChipText}"/>
                                        </Border>

                                        <!-- Total -->
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding Total, StringFormat='{}{0:C0}'}"
                                                   FontSize="13.5" FontWeight="SemiBold"
                                                   Typography.NumeralAlignment="Tabular"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   VerticalAlignment="Center" TextAlignment="Right"
                                                   Margin="0,0,16,0"/>

                                        <!-- Estado editable inline -->
                                        <StackPanel Grid.Column="4" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Ellipse Width="9" Height="9" Margin="0,0,8,0"
                                                     VerticalAlignment="Center"
                                                     Fill="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                                            <ComboBox MinWidth="146" Height="36"
                                                      ItemsSource="{Binding DataContext.StatusOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedValue="{Binding Status, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      SelectedValuePath="Value"
                                                      DisplayMemberPath="Label"
                                                      FontWeight="SemiBold" FontSize="12"
                                                      Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"
                                                      ToolTip="Cambiar el estado guarda inmediatamente en la base"/>
                                        </StackPanel>

                                        <!-- Acciones: aparecen con el hover de la fila -->
                                        <StackPanel Grid.Column="5" Orientation="Horizontal"
                                                    Style="{StaticResource RowActions}"
                                                    VerticalAlignment="Center" Margin="8,0,0,0">
                                            <Button Style="{StaticResource IconButton}" Width="34" Height="34"
                                                    ToolTip="Abrir en el armador de presupuestos"
                                                    AutomationProperties.Name="Abrir en el armador"
                                                    Command="{Binding DataContext.OpenOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" Width="34" Height="34" Margin="2,0,0,0"
                                                    ToolTip="Repetir pedido: copia con precios vigentes y fechas nuevas"
                                                    AutomationProperties.Name="Repetir pedido"
                                                    Command="{Binding DataContext.RepeatOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="&#xE8F4;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" Width="34" Height="34" Margin="2,0,0,0"
                                                    ToolTip="Historial: quién generó, editó o cambió el estado y cuándo"
                                                    AutomationProperties.Name="Ver historial de la orden"
                                                    Command="{Binding DataContext.ShowHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Pie: resultado del filtrado -->
                <TextBlock Grid.Row="1" Text="{Binding StatusMessage}"
                           FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                           Typography.NumeralAlignment="Tabular"
                           Margin="6,10,0,0"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
