<UserControl x:Class="Alquitel.UI.Views.ClientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Alquitel.UI.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ HEADER ═══════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="Clientes" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Directorio corporativo con validación de CUIT (AFIP)."
                           Style="{StaticResource PageSubtitle}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshAsyncCommand}"
                        ToolTip="Recargar lista de clientes" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Actualizar" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding ExportCsvCommand}"
                        ToolTip="Exportar directorio a CSV (Excel)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEDE1;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Exportar CSV" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                        Command="{Binding NewClientCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Nuevo Cliente" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════ IZQUIERDA: LISTA ═══════════ -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,20,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Buscador -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBox Height="40" Padding="36,10,14,10"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   VerticalAlignment="Center" Margin="14,0,0,0"
                                   IsHitTestVisible="False"/>
                        <TextBlock Text="Buscar empresa, CUIT o contacto"
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="12"
                                   VerticalAlignment="Center" Margin="38,0,0,0"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Skeleton mientras cargan los clientes (latencia en modo Supabase) -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Top" Panel.ZIndex="1"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource SkeletonRow}"/>
                        <Border Style="{StaticResource SkeletonRow}" Opacity="0.5"/>
                        <Border Style="{StaticResource SkeletonRow}" Opacity="0.45"/>
                        <Border Style="{StaticResource SkeletonRow}" Opacity="0.35"/>
                    </StackPanel>

                    <ListBox Grid.Row="1" ItemsSource="{Binding ClientsCollectionView}"
                             SelectedItem="{Binding SelectedClient, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource NavListItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource AvatarBadge}" Margin="0,0,12,0">
                                        <TextBlock Text="&#xE716;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                   Foreground="{DynamicResource SecondaryColorBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CompanyName}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Cuit}" FontSize="11"
                                                   Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ═══════════ DERECHA: ESTADO VACÍO ═══════════ -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding IsEditing, Converter={StaticResource InvBoolToVis}}">
                <TextBlock Text="&#xE716;" Style="{StaticResource EmptyStateIcon}"/>
                <TextBlock Text="Seleccioná un cliente" Style="{StaticResource EmptyStateTitle}"/>
                <TextBlock Text="Elegí uno de la lista para ver o editar sus datos,&#x0a;o creá uno nuevo con el botón de arriba."
                           Style="{StaticResource EmptyStateHint}"/>
            </StackPanel>

            <!-- ═══════════ DERECHA: EDITOR ═══════════ -->
            <Border Grid.Column="1" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,0,4,20" MaxWidth="720" HorizontalAlignment="Left">

                        <Border Style="{StaticResource Card}" Padding="26,22" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <Border Style="{StaticResource SectionIconBox}">
                                        <TextBlock Text="&#xE716;" Style="{StaticResource SectionIconGlyph}"/>
                                    </Border>
                                    <TextBlock Text="Datos de la empresa" Style="{StaticResource SectionTitle}"/>
                                </StackPanel>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.6*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="Empresa / Cliente" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Height="42" Text="{Binding EditCompanyName, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="CUIT" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Height="42" Text="{Binding EditCuit, UpdateSourceTrigger=PropertyChanged}"/>
                                        <!-- Feedback inline ✓/✗ al pie del campo -->
                                        <TextBlock Text="{Binding CuitFeedback}" FontSize="11"
                                                   TextWrapping="Wrap" Margin="4,3,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CuitFeedbackIsError}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CuitFeedback}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="Contacto" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Height="42" Text="{Binding EditContactName, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Teléfono" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Height="42" Text="{Binding EditPhone, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Height="42" Text="{Binding EditEmail, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Descuento acordado % (vacío = sin acuerdo)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Height="42" Text="{Binding EditSpecialDiscount, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Precio especial del cliente: el armador aplica este % de descuento por defecto al seleccionarlo (editable en cada presupuesto)."/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Notas internas (no se imprimen en documentos)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Height="90" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         VerticalContentAlignment="Top" Padding="14,10"
                                         Text="{Binding EditInternalNotes, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Uso interno del equipo: condiciones de pago, historial de trato, etc."/>

                                <!-- Quick-win IA: resumen del historial de pedidos -->
                                <Button Height="36" Margin="0,14,0,0" HorizontalAlignment="Left"
                                        Command="{Binding SummarizeClientHistoryCommand}"
                                        AutomationProperties.Name="Resumir historial del cliente con inteligencia artificial"
                                        ToolTip="IA: resume qué alquila este cliente, con qué frecuencia y por qué montos.">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSummarizing}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                   VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="Resumen IA del historial" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Border Padding="14,10" Margin="0,10,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource CardInner}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ClientAiSummary}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding ClientAiSummary}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextBrush}"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Acciones -->
                        <Grid>
                            <Button Style="{StaticResource GhostDangerButton}" Height="42" HorizontalAlignment="Left"
                                    Command="{Binding DeleteClientCommand}" Content="Eliminar"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource SecondaryButton}" Height="42" Margin="0,0,8,0"
                                        Command="{Binding CancelEditCommand}" Content="Cancelar"/>
                                <Button Style="{StaticResource PrimaryButton}" Height="42"
                                        Command="{Binding SaveClientCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Guardar Cliente" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="13"
                                   Foreground="{DynamicResource SecondaryColorBrush}"
                                   HorizontalAlignment="Right" Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
