<Window x:Class="Alquitel.UI.Views.BranchEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nueva versión de presupuesto"
        Width="760" Height="640" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFontFamily}"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">

    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ HEADER ═══════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal">
                <Border Width="44" Height="44" CornerRadius="12"
                        Background="{DynamicResource SecondaryColorBrush}">
                    <TextBlock Text="&#xE8F4;" FontFamily="{StaticResource IconFont}" FontSize="18"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="Nueva versión de presupuesto" FontSize="17" FontWeight="Bold"/>
                    <TextBlock FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                               Text="Ajustá los ítems y creá la rama. La versión anterior no se modifica."/>
                </StackPanel>
            </StackPanel>

            <!-- Badge número: 31294 → 31294/2 -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="14,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding OriginalNumber}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="  →  " FontSize="14" Foreground="{DynamicResource MutedTextBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding NewNumber}" FontSize="16" FontWeight="Black"
                               Foreground="{DynamicResource SecondaryColorBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════ DATOS DEL PEDIDO ═══════════ -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Text="Cliente" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding ClientName}" FontSize="14" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                    <TextBlock Text="Lugar" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding LocationName}" FontSize="14" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="2" MinWidth="160">
                    <TextBlock Text="Fecha del evento" Style="{StaticResource FieldLabel}"/>
                    <DatePicker SelectedDate="{Binding EventDate}" Height="34"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ ITEMS ═══════════ -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Alta de productos del catálogo -->
                <Grid Grid.Row="0" Margin="8,8,8,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" Height="38"
                              ItemsSource="{Binding Catalog}"
                              SelectedItem="{Binding SelectedProductToAdd}"
                              DisplayMemberPath="CleanDescription"
                              TextSearch.TextPath="CleanDescription"
                              IsEditable="True"
                              IsTextSearchCaseSensitive="False"
                              ToolTip="Escribí para buscar un producto del catálogo"/>
                    <Button Grid.Column="1" Style="{StaticResource SuccessButton}" Height="38"
                            Margin="8,0,0,0" MinWidth="150"
                            Command="{Binding AddProductCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Agregar producto" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}" Margin="8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                    Padding="8,10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Include}" Value="False">
                                                <Setter Property="Opacity" Value="0.45"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" Style="{StaticResource ModernCheckBox}"
                                              IsChecked="{Binding Include}" VerticalAlignment="Center"
                                              Margin="0,0,10,0"
                                              ToolTip="Incluir este ítem en la nueva versión"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Description}" FontSize="13" FontWeight="SemiBold"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding RequestedMeasure, StringFormat='Medida: {0}'}"
                                                   FontSize="11" Foreground="{DynamicResource MutedTextBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RequestedMeasure}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RequestedMeasure}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="0,0,8,0" Width="64">
                                        <TextBlock Text="Cant." Style="{StaticResource FieldLabel}"/>
                                        <TextBox Height="32" FontSize="12" TextAlignment="Center"
                                                 Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding Include}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Margin="0,0,8,0" Width="64">
                                        <TextBlock Text="Días" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Height="32" FontSize="12" TextAlignment="Center"
                                                 Text="{Binding Dias, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding Include}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4" Margin="0,0,8,0" Width="110">
                                        <TextBlock Text="Precio U." Style="{StaticResource FieldLabel}"/>
                                        <TextBox Height="32" FontSize="12" TextAlignment="Right"
                                                 Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding Include}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="5" Text="{Binding Subtotal, StringFormat='{}{0:C0}'}"
                                               FontSize="13" FontWeight="Bold" TextAlignment="Right"
                                               Foreground="{DynamicResource SecondaryColorBrush}"
                                               VerticalAlignment="Center"/>

                                    <Button Grid.Column="6" Width="30" Height="30" Margin="10,0,0,0"
                                            Style="{StaticResource GhostDangerButton}" Padding="0"
                                            VerticalAlignment="Center"
                                            ToolTip="Quitar este producto de la nueva versión"
                                            Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="11"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ═══════════ FOOTER ═══════════ -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding IncludedCount, StringFormat='{}{0} ítem(s) incluidos'}"
                           FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock Text="Total: " FontSize="16" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Total, StringFormat='{}{0:C0}'}" FontSize="18" FontWeight="Black"
                           Foreground="{DynamicResource SecondaryColorBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Style="{StaticResource SecondaryButton}"
                        Height="42" MinWidth="110" Margin="0,0,10,0" IsCancel="True"
                        Click="Cancel_Click"/>
                <Button Style="{StaticResource PrimaryButton}" Height="42" MinWidth="220"
                        IsDefault="True" Click="Create_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8F4;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding NewNumber, StringFormat='Crear versión {0} y editar'}"
                                   FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
