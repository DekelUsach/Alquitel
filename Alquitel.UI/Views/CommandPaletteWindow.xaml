<Window x:Class="Alquitel.UI.Views.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paleta de comandos"
        Width="560" MaxHeight="480" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFontFamily}"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="14" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.3"/>
        </Border.Effect>
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Buscador -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="{StaticResource IconFont}"
                               FontSize="14" Foreground="{DynamicResource MutedTextBrush}"
                               VerticalAlignment="Center" Margin="14,0,0,0"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1"
                             Background="Transparent" BorderThickness="0"
                             Padding="10,12" FontSize="14"
                             Foreground="{DynamicResource TextBrush}"
                             CaretBrush="{DynamicResource TextBrush}"
                             AutomationProperties.Name="Buscar comandos, clientes, productos o presupuestos"
                             TextChanged="SearchBox_TextChanged"/>
                </Grid>
            </Border>

            <!-- Resultados -->
            <ListBox x:Name="ResultsList" Grid.Row="1"
                     Background="Transparent" BorderThickness="0"
                     MaxHeight="330"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="ResultsList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Icon}" FontFamily="{StaticResource IconFont}"
                                       FontSize="13" Foreground="{DynamicResource SecondaryColorBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13"
                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Margin="4,6"/>
                            <TextBlock Grid.Column="2" Text="{Binding Category}" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"
                                       Margin="10,0,6,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="2" Margin="6,10,0,0" FontSize="10.5"
                       Foreground="{DynamicResource MutedTextBrush}"
                       Text="↑↓ navegar  ·  Enter ejecutar  ·  Esc cerrar"/>
        </Grid>
    </Border>
</Window>
