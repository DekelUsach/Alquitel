<UserControl x:Class="Alquitel.UI.Views.LocationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Alquitel.UI.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ HEADER ═══════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="Ubicaciones" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Lugares físicos donde se realizan los eventos."
                           Style="{StaticResource PageSubtitle}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Command="{Binding NewLocationCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Nueva Ubicación" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════ IZQUIERDA: LISTA ═══════════ -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,20,0">
                <ListBox ItemsSource="{Binding Locations}"
                         SelectedItem="{Binding SelectedLocation, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource NavListItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource AvatarBadge}" Margin="0,0,12,0">
                                    <TextBlock Text="&#xE707;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                               Foreground="{DynamicResource SecondaryColorBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- ═══════════ DERECHA: ESTADO VACÍO ═══════════ -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding IsEditing, Converter={StaticResource InvBoolToVis}}">
                <TextBlock Text="&#xE707;" Style="{StaticResource EmptyStateIcon}"/>
                <TextBlock Text="Seleccioná una ubicación" Style="{StaticResource EmptyStateTitle}"/>
                <TextBlock Text="Elegí una de la lista para editarla,&#x0a;o creá una nueva con el botón de arriba."
                           Style="{StaticResource EmptyStateHint}"/>
            </StackPanel>

            <!-- ═══════════ DERECHA: EDITOR ═══════════ -->
            <Border Grid.Column="1" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,0,4,20" MaxWidth="720" HorizontalAlignment="Left">

                        <Border Style="{StaticResource Card}" Padding="26,22" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <Border Style="{StaticResource SectionIconBox}">
                                        <TextBlock Text="&#xE707;" Style="{StaticResource SectionIconGlyph}"/>
                                    </Border>
                                    <TextBlock Text="Datos de la ubicación" Style="{StaticResource SectionTitle}"/>
                                </StackPanel>

                                <TextBlock Text="Nombre (ej. Predio de La Rural)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Height="42" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Border>

                        <!-- Acciones -->
                        <Grid>
                            <Button Style="{StaticResource GhostDangerButton}" Height="42" HorizontalAlignment="Left"
                                    Command="{Binding DeleteLocationCommand}" Content="Eliminar"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource SecondaryButton}" Height="42" Margin="0,0,8,0"
                                        Command="{Binding CancelEditCommand}" Content="Cancelar"/>
                                <Button Style="{StaticResource PrimaryButton}" Height="42"
                                        Command="{Binding SaveLocationCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Guardar Ubicación" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="13"
                                   Foreground="{DynamicResource SecondaryColorBrush}"
                                   HorizontalAlignment="Right" Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
