<UserControl x:Class="Alquitel.UI.Views.ProductEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Alquitel.UI.Converters"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="30,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════ LEFT: PRODUCT LIST ═══════════ -->
        <Border Grid.Column="0" Padding="0,0,16,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Productos" FontSize="28" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}" Margin="4,8,0,16"/>

                <Button Grid.Row="1" Style="{StaticResource DarkPillButton}" Height="44" Margin="0,0,0,12"
                        HorizontalAlignment="Stretch"
                        Command="{Binding NewProductCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Nuevo Producto" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- SearchBox -->
                <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="12"
                        Padding="12,0" Margin="0,0,0,16" Height="40">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}"
                                 VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="13" />
                    </Grid>
                </Border>

                <ListBox Grid.Row="3" ItemsSource="{Binding Products}"
                         SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,4"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="itemBorder" Background="Transparent"
                                                CornerRadius="12" Padding="14,10">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="itemBorder" Property="Background"
                                                        Value="{DynamicResource HoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="itemBorder" Property="Background"
                                                        Value="{DynamicResource SelectionBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Description}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding Category}" FontSize="11"
                                               Foreground="{DynamicResource MutedTextBrush}"/>
                                    <TextBlock Text=" · " Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/>
                                    <TextBlock Text="{Binding BasePrice, StringFormat='{}{0:C}'}" FontSize="11"
                                               Foreground="{DynamicResource SecondaryColorBrush}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ═══════════ RIGHT: EDITOR FORM ═══════════ -->
        <Border Grid.Column="1" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,0,0,0">
                <StackPanel Margin="10,8,10,20">

                    <TextBlock Text="Editar Producto" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}" Margin="0,8,0,20"/>

                    <!-- ── Información General ── -->
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="18" Padding="24,20"
                            Effect="{StaticResource StandardShadow}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="INFORMACIÓN GENERAL" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource SecondaryColorBrush}" Margin="0,0,0,14"/>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Categoría" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                                               FontWeight="SemiBold" Margin="4,0,0,5"/>
                                    <TextBox Height="42" Text="{Binding EditCategory, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Precio Base" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                                               FontWeight="SemiBold" Margin="4,0,0,5"/>
                                    <TextBox Height="42" Text="{Binding EditBasePrice, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <!-- ── Descripción segmentada ── -->
                            <TextBlock Text="DESCRIPCIÓN DEL PRODUCTO (título)" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource SecondaryColorBrush}" Margin="0,0,0,10"/>
                            <TextBlock FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,12"
                                       TextWrapping="Wrap"
                                       Text="Añadí segmentos de texto. Cada uno puede tener su propio color y estilo. Se concatenan para formar el título del producto en el presupuesto."/>

                            <!-- Live preview -->
                            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8"
                                    Padding="12,8" Margin="0,0,0,12">
                                <ItemsControl ItemsSource="{Binding DescriptionSegments}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}"
                                                       Foreground="{Binding PreviewBrush}"
                                                       FontWeight="{Binding IsBold, Converter={x:Static local:BoolToFontWeightConverter.Instance}}"
                                                       FontStyle="{Binding IsItalic, Converter={x:Static local:BoolToFontStyleConverter.Instance}}"
                                                       FontSize="13" Margin="0,0,0,0"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <!-- Segments list -->
                            <ItemsControl ItemsSource="{Binding DescriptionSegments}" Margin="0,0,0,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10"
                                                Padding="12,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Texto -->
                                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                    <TextBlock Text="Texto" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" Margin="2,0,0,3"/>
                                                    <TextBox Height="34" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Padding="8,0"/>
                                                </StackPanel>

                                                <!-- Color -->
                                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                    <TextBlock Text="Color" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" Margin="2,0,0,3"/>
                                                    <xctk:ColorPicker Height="34"
                                                                      SelectedColor="{Binding ColorHex, Converter={x:Static local:HexToColorConverter.Instance}}" />
                                                </StackPanel>

                                                <!-- Negrita -->
                                                <StackPanel Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Bottom" Height="34">
                                                    <CheckBox Content="N" IsChecked="{Binding IsBold}"
                                                              Foreground="{DynamicResource TextBrush}"
                                                              VerticalAlignment="Center" Margin="0,8,0,0" ToolTip="Negrita"/>
                                                </StackPanel>

                                                <!-- Cursiva -->
                                                <StackPanel Grid.Column="3" Margin="0,0,10,0" VerticalAlignment="Bottom" Height="34">
                                                    <CheckBox Content="I" IsChecked="{Binding IsItalic}"
                                                              Foreground="{DynamicResource TextBrush}"
                                                              FontStyle="Italic"
                                                              VerticalAlignment="Center" Margin="0,8,0,0" ToolTip="Cursiva"/>
                                                </StackPanel>

                                                <!-- Eliminar -->
                                                <Button Grid.Column="4" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="#E53E3E" Cursor="Hand" FontSize="14"
                                                        VerticalAlignment="Bottom" Height="34"
                                                        Command="{Binding DataContext.RemoveDescriptionSegmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Eliminar segmento"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Style="{StaticResource DarkPillButton}" Height="36" Width="180" HorizontalAlignment="Left"
                                    Command="{Binding AddDescriptionSegmentCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Añadir Segmento" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- ── Imagen del Producto ── -->
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="18" Padding="24,20"
                            Effect="{StaticResource StandardShadow}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="IMAGEN (Opcional)" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource SecondaryColorBrush}" Margin="0,0,0,14"/>
                            
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource DarkPillButton}" Height="34" Width="120"
                                        Command="{Binding SelectImageCommand}" Margin="0,0,12,0">
                                    <TextBlock Text="Seleccionar..." FontSize="12"/>
                                </Button>
                                
                                <TextBlock Text="{Binding EditImagePath}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,0,12,0"/>
                                           
                                <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="#E53E3E" Cursor="Hand" FontSize="14"
                                        Command="{Binding RemoveImageCommand}"
                                        ToolTip="Quitar imagen"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!-- ── Campos Personalizados ── -->
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="18" Padding="24,20"
                            Effect="{StaticResource StandardShadow}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="CAMPOS PERSONALIZADOS (Aparecerán en el Presupuesto)" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource SecondaryColorBrush}" Margin="0,0,0,14"/>

                            <ItemsControl ItemsSource="{Binding CustomFields}" Margin="0,0,0,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Label -->
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="Etiqueta" FontSize="10" Foreground="{DynamicResource MutedTextBrush}"/>
                                                <TextBox Height="34" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Padding="8,0"/>
                                            </StackPanel>

                                            <!-- Value -->
                                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                <TextBlock Text="Valor" FontSize="10" Foreground="{DynamicResource MutedTextBrush}"/>
                                                <TextBox Height="34" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Padding="8,0"/>
                                            </StackPanel>

                                            <!-- Bold -->
                                            <StackPanel Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Bottom" Height="34" HorizontalAlignment="Center">
                                                <CheckBox Content="N." IsChecked="{Binding IsBold}" Foreground="{DynamicResource TextBrush}"
                                                          VerticalAlignment="Center" Margin="0,8,0,0" ToolTip="Negrita"/>
                                            </StackPanel>
                                            
                                            <!-- Underline -->
                                            <StackPanel Grid.Column="3" Margin="0,0,8,0" VerticalAlignment="Bottom" Height="34" HorizontalAlignment="Center">
                                                <CheckBox Content="S." IsChecked="{Binding IsUnderline}" Foreground="{DynamicResource TextBrush}"
                                                          VerticalAlignment="Center" Margin="0,8,0,0" ToolTip="Subrayado"/>
                                            </StackPanel>

                                            <!-- Color -->
                                            <StackPanel Grid.Column="4" Margin="0,0,8,0">
                                                <TextBlock Text="Color" FontSize="10" Foreground="{DynamicResource MutedTextBrush}"/>
                                                <xctk:ColorPicker Height="34"
                                                                  SelectedColor="{Binding ColorHex, Converter={x:Static local:HexToColorConverter.Instance}}" />
                                            </StackPanel>

                                            <!-- Remove -->
                                            <Button Grid.Column="5" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                    Background="Transparent" BorderThickness="0"
                                                    Foreground="#E53E3E" Cursor="Hand"
                                                    Command="{Binding DataContext.RemoveCustomFieldCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    VerticalAlignment="Bottom" Height="34" ToolTip="Eliminar campo" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Style="{StaticResource DarkPillButton}" Height="36" Width="150" HorizontalAlignment="Left"
                                    Command="{Binding AddCustomFieldCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Añadir Campo" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- ── Action Buttons ── -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                        <Button Height="44" Padding="20,0" Margin="0,0,8,0"
                                Background="{DynamicResource SurfaceAltBrush}"
                                Foreground="{DynamicResource TextBrush}"
                                BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                Cursor="Hand"
                                Command="{Binding CancelEditCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="20" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="Cancelar" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Button>

                        <Button Style="{StaticResource DarkPillButton}" Height="44" Padding="24,0" Margin="0,0,8,0"
                                Background="#D46A6A"
                                Command="{Binding DeleteProductCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Eliminar" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource DarkPillButton}" Height="44" Padding="24,0"
                                Command="{Binding SaveProductCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Guardar Producto" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Status -->
                    <TextBlock Text="{Binding StatusMessage}" FontSize="13" Margin="0,12,0,0"
                               HorizontalAlignment="Right"
                               Foreground="{DynamicResource SecondaryColorBrush}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Empty state when not editing -->
        <Border Grid.Column="1"
                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}, ConverterParameter=inverse}"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Only show when IsEditing is false — WPF BoolToVis doesn't support inverse natively,
                 so we layer this behind the editor which covers it when visible -->
        </Border>
    </Grid>
</UserControl>
