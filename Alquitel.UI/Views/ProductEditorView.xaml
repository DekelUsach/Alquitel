<UserControl x:Class="Alquitel.UI.Views.ProductEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Alquitel.UI.Converters"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
        <local:StripTagsConverter x:Key="StripTagsConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="32,28,32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

        <!-- ═══════════ HEADER ═══════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="Productos" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Catálogo de equipamiento con descripción segmentada y campos dinámicos."
                           Style="{StaticResource PageSubtitle}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding ToggleWordPreviewCommand}"
                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                        ToolTip="Mostrar u ocultar la vista previa de cómo quedará el producto en el documento Word"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Vista Word" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshAsyncCommand}"
                        ToolTip="Recargar catálogo de productos" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Actualizar" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding ExportCsvCommand}"
                        ToolTip="Exportar catálogo a CSV (Excel)" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEDE1;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Exportar CSV" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}"
                        Command="{Binding NewProductCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Nuevo Producto" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════ IZQUIERDA: LISTA ═══════════ -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,20,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Buscador -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBox Height="40" Padding="36,10,14,10"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   VerticalAlignment="Center" Margin="14,0,0,0"
                                   IsHitTestVisible="False"/>
                        <TextBlock Text="Buscar por descripción o categoría"
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="12"
                                   VerticalAlignment="Center" Margin="38,0,0,0"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Products}"
                             SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource NavListItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource AvatarBadge}" Margin="0,0,12,0">
                                        <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                   Foreground="{DynamicResource SecondaryColorBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Description, Converter={StaticResource StripTagsConverter}}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding Category}" FontSize="11"
                                                       Foreground="{DynamicResource MutedTextBrush}"/>
                                            <TextBlock Text=" · " Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/>
                                            <TextBlock Text="{Binding BasePrice, StringFormat='{}{0:C}'}" FontSize="11"
                                                       Foreground="{DynamicResource SecondaryColorBrush}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ═══════════ DERECHA: ESTADO VACÍO ═══════════ -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding IsEditing, Converter={StaticResource InvBoolToVis}}">
                <TextBlock Text="&#xE7B8;" Style="{StaticResource EmptyStateIcon}"/>
                <TextBlock Text="Seleccioná un producto" Style="{StaticResource EmptyStateTitle}"/>
                <TextBlock Text="Elegí uno del catálogo para editarlo,&#x0a;o creá uno nuevo con el botón de arriba."
                           Style="{StaticResource EmptyStateHint}"/>
            </StackPanel>

            <!-- ═══════════ DERECHA: EDITOR ═══════════ -->
            <Border Grid.Column="1" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,0,4,20">

                        <!-- ── Información general ── -->
                        <Border Style="{StaticResource Card}" Padding="26,22" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <Border Style="{StaticResource SectionIconBox}">
                                        <TextBlock Text="&#xE7B8;" Style="{StaticResource SectionIconGlyph}"/>
                                    </Border>
                                    <TextBlock Text="Información general" Style="{StaticResource SectionTitle}"/>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="Categoría" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Height="42" Text="{Binding EditCategory, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Precio Base" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Height="42" Text="{Binding EditBasePrice, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- §2 Stock físico / §3 Costo interno -->
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="Stock total (vacío = sin control)" Style="{StaticResource FieldLabel}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Style="{StaticResource StepperButton}" Content="&#x2212;"
                                                    Command="{Binding DecrementStockCommand}"
                                                    AutomationProperties.Name="Restar una unidad de stock"
                                                    ToolTip="Restar una unidad"/>
                                            <TextBox Grid.Column="1" Height="42" Margin="4,0"
                                                     TextAlignment="Center"
                                                     Text="{Binding EditStockQuantity, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Cantidad física total disponible. Dejalo vacío para servicios o ítems sin control de disponibilidad."/>
                                            <Button Grid.Column="2" Style="{StaticResource StepperButton}" Content="+"
                                                    Command="{Binding IncrementStockCommand}"
                                                    AutomationProperties.Name="Sumar una unidad de stock"
                                                    ToolTip="Sumar una unidad"/>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Costo interno x día (vacío = sin costo)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Height="42" Text="{Binding EditCost, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Costo por unidad por día. Solo se usa en Reportes para calcular margen; nunca se imprime en documentos."/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ── Calendario de disponibilidad de stock (30 días) ── -->
                        <Border Style="{StaticResource Card}" Padding="26,22" Margin="0,0,0,16"
                                Visibility="{Binding HasAvailability, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Style="{StaticResource SectionIconBox}">
                                        <TextBlock Text="&#xE787;" Style="{StaticResource SectionIconGlyph}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Disponibilidad de stock" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="{Binding AvailabilitySummary}" FontSize="11"
                                                   Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Grilla de días: unidades libres por fecha -->
                                <ItemsControl ItemsSource="{Binding AvailabilityDays}" Margin="0,4,0,8">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" Padding="8,6" Margin="0,0,6,6" MinWidth="58"
                                                    BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <!-- Sin compromisos: chip neutro -->
                                                        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                                        <Style.Triggers>
                                                            <!-- Comprometido pero con unidades libres -->
                                                            <DataTrigger Binding="{Binding Tone}" Value="ok">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                            <!-- Justo: 0 unidades libres -->
                                                            <DataTrigger Binding="{Binding Tone}" Value="tight">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                                                            </DataTrigger>
                                                            <!-- Sobrevendido -->
                                                            <DataTrigger Binding="{Binding Tone}" Value="over">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                                                <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DayLabel}" FontSize="10"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding CountLabel}" FontSize="13" FontWeight="Bold"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Órdenes activas que usan el producto -->
                                <ItemsControl ItemsSource="{Binding AvailabilityOrders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CardInner}" Padding="12,8" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding BudgetNumber}" FontWeight="Bold"
                                                               FontSize="12" Foreground="{DynamicResource SecondaryColorBrush}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ClientName}" FontSize="12"
                                                               Foreground="{DynamicResource TextBrush}" Margin="10,0"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding RangeLabel}" FontSize="11"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <TextBlock Grid.Column="3" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center">
                                                        <Run Text="{Binding Quantity, Mode=OneWay}"/><Run Text=" u."/>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- ── Descripción segmentada ── -->
                        <Border Style="{StaticResource Card}" Padding="26,22" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Style="{StaticResource SectionIconBox}">
                                        <TextBlock Text="&#xE8D2;" Style="{StaticResource SectionIconGlyph}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Descripción del producto (título)" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                                                   TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Text="Cada segmento tiene su color y estilo. Se concatenan para formar el título en el presupuesto."/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Vista previa en vivo -->
                                <TextBlock Text="Vista previa" Style="{StaticResource FieldLabel}" Margin="4,10,0,6"/>
                                <Border Style="{StaticResource CardInner}" Padding="14,12" Margin="0,0,0,16">
                                    <ItemsControl ItemsSource="{Binding DescriptionSegments}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Text}"
                                                           Foreground="{Binding PreviewBrush}"
                                                           FontWeight="{Binding IsBold, Converter={x:Static local:BoolToFontWeightConverter.Instance}}"
                                                           FontStyle="{Binding IsItalic, Converter={x:Static local:BoolToFontStyleConverter.Instance}}"
                                                           FontSize="14"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <!-- Lista de segmentos -->
                                <ItemsControl ItemsSource="{Binding DescriptionSegments}" Margin="0,0,0,12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CardInner}" Padding="14,12" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBox Grid.Column="0" Height="36" Margin="0,0,10,0"
                                                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                             Padding="10,0" VerticalAlignment="Center"
                                                             ToolTip="Texto del segmento"/>

                                                    <xctk:ColorPicker Grid.Column="1" Height="36" Margin="0,0,10,0"
                                                                      VerticalAlignment="Center"
                                                                      ToolTip="Color del texto"
                                                                      SelectedColor="{Binding ColorHex, Converter={x:Static local:HexToColorConverter.Instance}}"/>

                                                    <CheckBox Grid.Column="2" Style="{StaticResource ModernCheckBox}"
                                                              Margin="0,0,12,0" VerticalAlignment="Center"
                                                              IsChecked="{Binding IsBold}" ToolTip="Negrita">
                                                        <TextBlock Text="N" FontWeight="Bold" FontSize="12"/>
                                                    </CheckBox>

                                                    <CheckBox Grid.Column="3" Style="{StaticResource ModernCheckBox}"
                                                              Margin="0,0,8,0" VerticalAlignment="Center"
                                                              IsChecked="{Binding IsItalic}" ToolTip="Cursiva">
                                                        <TextBlock Text="I" FontStyle="Italic" FontSize="12"/>
                                                    </CheckBox>

                                                    <Button Grid.Column="4" Style="{StaticResource IconButton}"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding DataContext.RemoveDescriptionSegmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Eliminar segmento">
                                                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                                   Foreground="{DynamicResource DangerBrush}"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Style="{StaticResource SecondaryButton}" Height="36" HorizontalAlignment="Left"
                                        Command="{Binding AddDescriptionSegmentCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Añadir Segmento" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- ── Imagen del producto ── -->
                        <Border Style="{StaticResource Card}" Padding="26,22" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border Style="{StaticResource SectionIconBox}">
                                        <TextBlock Text="&#xEB9F;" Style="{StaticResource SectionIconGlyph}"/>
                                    </Border>
                                    <TextBlock Text="Imagen (opcional)" Style="{StaticResource SectionTitle}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource SecondaryButton}" Height="36"
                                            Command="{Binding SelectImageCommand}" Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                       Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Seleccionar..." FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <TextBlock Text="{Binding EditImagePath}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,0,12,0"
                                               TextTrimming="CharacterEllipsis" MaxWidth="420"/>

                                    <Button Style="{StaticResource IconButton}" VerticalAlignment="Center"
                                            Command="{Binding RemoveImageCommand}" ToolTip="Quitar imagen">
                                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                   Foreground="{DynamicResource DangerBrush}"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ── Campos personalizados ── -->
                        <Border Style="{StaticResource Card}" Padding="26,22" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border Style="{StaticResource SectionIconBox}">
                                        <TextBlock Text="&#xE8FD;" Style="{StaticResource SectionIconGlyph}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Campos personalizados" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="Aparecerán como especificaciones en el presupuesto."
                                                   FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding CustomFields}" Margin="0,0,0,12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CardInner}" Padding="14,12" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.4*"/>
                                                        <ColumnDefinition Width="2*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBox Grid.Column="0" Height="36" Margin="0,0,10,0"
                                                             Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                                             Padding="10,0" VerticalAlignment="Center"
                                                             ToolTip="Etiqueta (ej. Resolución)"/>

                                                    <TextBox Grid.Column="1" Height="36" Margin="0,0,10,0"
                                                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                             Padding="10,0" VerticalAlignment="Center"
                                                             ToolTip="Valor (ej. 1920x1080)"/>

                                                    <CheckBox Grid.Column="2" Style="{StaticResource ModernCheckBox}"
                                                              Margin="0,0,12,0" VerticalAlignment="Center"
                                                              IsChecked="{Binding IsBold}" ToolTip="Negrita">
                                                        <TextBlock Text="N" FontWeight="Bold" FontSize="12"/>
                                                    </CheckBox>

                                                    <CheckBox Grid.Column="3" Style="{StaticResource ModernCheckBox}"
                                                              Margin="0,0,12,0" VerticalAlignment="Center"
                                                              IsChecked="{Binding IsUnderline}" ToolTip="Subrayado">
                                                        <TextBlock Text="S" FontSize="12">
                                                            <TextBlock.TextDecorations>
                                                                <TextDecorationCollection>Underline</TextDecorationCollection>
                                                            </TextBlock.TextDecorations>
                                                        </TextBlock>
                                                    </CheckBox>

                                                    <xctk:ColorPicker Grid.Column="4" Height="36" Margin="0,0,8,0"
                                                                      VerticalAlignment="Center"
                                                                      ToolTip="Color del texto"
                                                                      SelectedColor="{Binding ColorHex, Converter={x:Static local:HexToColorConverter.Instance}}"/>

                                                    <Button Grid.Column="5" Style="{StaticResource IconButton}"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding DataContext.RemoveCustomFieldCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Eliminar campo">
                                                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                                   Foreground="{DynamicResource DangerBrush}"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Style="{StaticResource SecondaryButton}" Height="36" HorizontalAlignment="Left"
                                        Command="{Binding AddCustomFieldCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Añadir Campo" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- ── Acciones ── -->
                        <Grid Margin="0,4,0,0">
                            <Button Style="{StaticResource GhostDangerButton}" Height="42" HorizontalAlignment="Left"
                                    Command="{Binding DeleteProductCommand}" Content="Eliminar"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource SecondaryButton}" Height="42" Margin="0,0,8,0"
                                        Command="{Binding CancelEditCommand}" Content="Cancelar"/>
                                <Button Style="{StaticResource SecondaryButton}" Height="42" Margin="0,0,8,0"
                                        Command="{Binding DuplicateProductCommand}"
                                        ToolTip="Crear una copia de este producto">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Duplicar" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource PrimaryButton}" Height="42"
                                        Command="{Binding SaveProductCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Guardar Producto" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Estado -->
                        <TextBlock Text="{Binding StatusMessage}" FontSize="13" Margin="0,12,0,0"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource SecondaryColorBrush}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ═══════════ VISTA PREVIA WORD ═══════════
                     Hoja "papel" que replica la geometría de ProductRenderer.cs:
                     1 cm ≈ 37.8 px (96 DPI), 1 pt ≈ 1.333 px. Fondo blanco fijo
                     (independiente del tema) porque simula papel real. -->
                <Border Grid.Column="1" Width="470" Margin="16,0,0,0"
                        Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Vista previa — documento Word"
                                   Style="{StaticResource FieldLabel}" Margin="4,0,0,8"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <Grid Cursor="Hand" ToolTip="Hacé click para ver la vista previa en tamaño completo">
                                <Grid.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding OpenZoomedPreviewCommand}"/>
                                </Grid.InputBindings>

                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly"
                                         HorizontalAlignment="Left" VerticalAlignment="Top">
                                <!-- Hoja A4: 21 cm ≈ 794 px de ancho; márgenes ~70 px -->
                                <Border Width="794" MinHeight="420" Background="White"
                                        CornerRadius="2" Padding="70,60" Margin="4,2,10,14">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.25"/>
                                    </Border.Effect>
                                    <StackPanel>

                                        <!-- 1. Título (12pt bold, sangría 1.9 cm) + miniatura 1.6 cm -->
                                        <Grid>
                                            <Image Width="60" Height="60" Stretch="Uniform"
                                                   HorizontalAlignment="Left" VerticalAlignment="Top"
                                                   Source="{Binding EditImagePath, Converter={x:Static local:PathToImageSourceConverter.Instance}}"/>
                                            <TextBlock Margin="72,0,0,0" FontFamily="Montserrat, Calibri"
                                                       FontSize="16" TextWrapping="Wrap"
                                                       local:WordPreviewInlines.Segments="{Binding TitlePreviewSegments}"/>
                                        </Grid>

                                        <!-- 2. Campos personalizados (9pt, justificado, sangrías 0.66+1.25/0.81 cm).
                                             WPF no soporta sangría de primera línea en TextBlock: se aproxima
                                             con margen izquierdo fijo a 1.9 cm (donde arranca la primera línea). -->
                                        <ItemsControl ItemsSource="{Binding CustomFields}" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Margin="72,2,31,0" FontFamily="Montserrat, Calibri"
                                                               FontSize="12" TextWrapping="Wrap" TextAlignment="Justify"
                                                               local:WordPreviewInlines.Segments="{Binding PreviewSegments}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- 3. Tabla resumen 1×4 (sangría 5.25 cm; anchos 2.0/1.75/3.44/4.81 cm;
                                             alto 0.63 cm; fondo azul WD_BLUE #1F68C7, texto blanco bold) -->
                                        <Grid Margin="198,20,0,0" Height="24" HorizontalAlignment="Left"
                                              Background="#1F68C7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="76"/>
                                                <ColumnDefinition Width="66"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="182"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.Resources>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontFamily" Value="Montserrat, Calibri"/>
                                                    <Setter Property="FontSize" Value="13"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Margin" Value="4,0,0,0"/>
                                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                </Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="White"/>
                                                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                                </Style>
                                            </Grid.Resources>
                                            <Border Grid.Column="0"><TextBlock Text="Cant.:  1"/></Border>
                                            <Border Grid.Column="1"><TextBlock Text="Días:  1"/></Border>
                                            <Border Grid.Column="2"><TextBlock Text="{Binding PreviewCostCell}"/></Border>
                                            <Border Grid.Column="3" BorderThickness="0">
                                                <TextBlock Text="{Binding PreviewTotalCell}" FontSize="16"/>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Viewbox>

                            <!-- Capa de hover (sutil oscurecimiento e indicador de zoom) -->
                            <Border x:Name="HoverOverlay" CornerRadius="2" Margin="4,2,10,14" Opacity="0" IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                                                <Setter Property="Background" Value="#1A000000"/>
                                                <Setter Property="Opacity" Value="1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Border Background="#CC1E293B" CornerRadius="20" Padding="12,8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE71E;" FontFamily="{StaticResource IconFont}" Foreground="White" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Ver más grande" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                    </DockPanel>
                </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>

    <!-- Overlay de vista previa ampliada (Modal) -->
    <Grid Visibility="{Binding IsZoomedPreviewVisible, Converter={StaticResource BoolToVis}}" Panel.ZIndex="1000">
        <!-- Background (Clickable backdrop) -->
        <Grid Background="#CC0B0F19">
            <Grid.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding CloseZoomedPreviewCommand}"/>
            </Grid.InputBindings>
        </Grid>
        
        <!-- Foreground (Zoomed A4 preview sheet and close button) -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Hoja A4 ampliada -->
            <Border Grid.Row="0" Background="White" CornerRadius="4" Padding="70,60" Margin="10"
                    Width="794" Height="800" MaxHeight="750">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.4"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- 1. Título (12pt bold, sangría 1.9 cm) + miniatura 1.6 cm -->
                        <Grid>
                            <Image Width="80" Height="80" Stretch="Uniform"
                                   HorizontalAlignment="Left" VerticalAlignment="Top"
                                   Source="{Binding EditImagePath, Converter={x:Static local:PathToImageSourceConverter.Instance}}"/>
                            <TextBlock Margin="96,0,0,0" FontFamily="Montserrat, Calibri"
                                       FontSize="20" TextWrapping="Wrap"
                                       local:WordPreviewInlines.Segments="{Binding TitlePreviewSegments}"/>
                        </Grid>

                        <!-- 2. Campos personalizados -->
                        <ItemsControl ItemsSource="{Binding CustomFields}" Margin="0,16,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="96,4,31,0" FontFamily="Montserrat, Calibri"
                                               FontSize="14" TextWrapping="Wrap" TextAlignment="Justify"
                                               local:WordPreviewInlines.Segments="{Binding PreviewSegments}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 3. Tabla resumen 1×4 -->
                        <Grid Margin="240,30,0,0" Height="32" HorizontalAlignment="Left"
                              Background="#1F68C7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="240"/>
                            </Grid.ColumnDefinitions>
                            <Grid.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Montserrat, Calibri"/>
                                    <Setter Property="FontSize" Value="15"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="6,0,0,0"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                </Style>
                            </Grid.Resources>
                            <Border Grid.Column="0"><TextBlock Text="Cant.:  1"/></Border>
                            <Border Grid.Column="1"><TextBlock Text="Días:  1"/></Border>
                            <Border Grid.Column="2"><TextBlock Text="{Binding PreviewCostCell}"/></Border>
                            <Border Grid.Column="3" BorderThickness="0">
                                <TextBlock Text="{Binding PreviewTotalCell}" FontSize="18"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            
            <!-- Botón de Cerrar -->
            <Button Grid.Row="1" Style="{StaticResource SecondaryButton}" 
                    Command="{Binding CloseZoomedPreviewCommand}" 
                    HorizontalAlignment="Center" Margin="0,16,0,0" Height="40" Width="120">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Cerrar" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Grid>
</UserControl>
